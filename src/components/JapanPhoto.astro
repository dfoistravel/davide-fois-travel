---
import { japanPhotos, japanPhotoCredits, type JapanPhotoKey } from '../data/japanPhotos';
interface Props {
  photo: JapanPhotoKey;
  variant?: 'hero' | 'card' | 'wide';
  eager?: boolean;
  caption?: string;
}
const { photo, variant = 'card', eager = false, caption } = Astro.props;
const item = japanPhotos[photo];
const credit = japanPhotoCredits[photo];
const base = import.meta.env.BASE_URL;
const highWidth = item.fileWidth;
const externalUrl = "externalUrl" in item ? item.externalUrl : null;
---
<figure class={`japan-photo japan-photo--${variant}`}>
  <img src={externalUrl || `${base}images/giappone/${photo}-${highWidth}.webp`}
    srcset={externalUrl ? undefined : `${base}images/giappone/${photo}-640.webp 640w, ${base}images/giappone/${photo}-${highWidth}.webp ${highWidth}w`}
    sizes={variant === 'card' ? '(max-width: 900px) 92vw, 380px' : '(max-width: 900px) 92vw, 600px'}
    width={item.width} height={item.height} alt={item.alt}
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async"
    style={`object-position: ${item.position};`} />
  {credit ? <figcaption><a href={credit.source}>Foto: {credit.author}</a> · <a href={credit.licenseUrl}>{credit.license}</a><br />{credit.changes}</figcaption> : caption && <figcaption>{caption}</figcaption>}
</figure>
