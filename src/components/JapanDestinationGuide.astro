---
import BaseLayout from '../layouts/BaseLayout.astro';
import JapanPhoto from './JapanPhoto.astro';
import { japanGuides } from '../data/japanGuides';
import { japanRegions } from '../data/japanRegions';
import type { JapanPhotoKey } from '../data/japanPhotos';
interface Props { guide: (typeof japanGuides)[number] }
const { guide: g } = Astro.props;
const base = import.meta.env.BASE_URL;
const region = japanRegions.find(r => r.guides.some(x => x.slug === g.slug));
const related = japanGuides.filter(x => x.slug !== g.slug && (!region || region.guides.some(y => y.slug === x.slug))).slice(0,6);
const caption = (photo: string) => photo === 'nara' ? 'Nara · Balon Greyjoy, CC0 · Wikimedia Commons' : `${g.name} · Fotografia di Davide Fois`;
const schema = { '@context': 'https://schema.org', '@type': 'Article', headline: g.title, description: g.intro, author: { '@type': 'Person', name: 'Davide Fois' }, inLanguage: 'it' };
---
<BaseLayout title={`${g.title} | Davide Fois Travel`} description={g.intro} schema={schema}>
<section class="hero"><div class="container jp-guide-hero"><div>
<p class="kicker"><a href={`${base}giappone/`}>Giappone</a> · {region ? <a href={`${base}giappone/regioni/${region.slug}/`}>{region.name}</a> : "Guida di viaggio"}</p><h1>{g.title}</h1><p class="lead">{g.intro}</p>
<div class="actions"><a class="button button-primary" href="#luoghi">Esplora i luoghi</a><a class="button button-ghost" href="#programma">Come organizzare la visita</a></div>
</div><JapanPhoto photo={g.photo} variant="hero" eager caption={caption(g.photo)} /></div></section>
<section class="section jp-summary"><div class="container jp-two"><article class="card"><p class="kicker">Il tempo da prevedere</p><h2>{g.duration}</h2><p>Indicazione di viaggio proposta da Davide: considera separatamente arrivi, partenze e tempi di trasferimento.</p></article><article class="card"><p class="kicker">A chi la consiglio</p><h2>Quale esperienza cerchi?</h2><p>{g.fit}</p><a href={`${base}quando-andare-giappone/`}>Scegli il periodo del viaggio →</a></article></div></section>
<nav class="container jp-jump" aria-label="In questa guida"><a href="#luoghi">Cosa vedere</a><a href="#programma">Programma</a><a href="#dormire">Dove dormire</a><a href="#consigli">Consigli pratici</a><a href="#domande">Domande frequenti</a></nav>
<section class="section" id="luoghi"><div class="container"><div class="section-head"><p class="kicker">Conoscere la destinazione</p><h2>I luoghi e il senso della visita</h2><p>Una selezione da adattare ai tuoi interessi: non una lista da completare a ogni costo.</p></div><div class="jp-places">{g.places.map(p => <article class:list={['card', 'jp-place', {'jp-place-photo': p.photo}]}>{p.photo && <JapanPhoto photo={p.photo as JapanPhotoKey} variant="wide" caption={caption(p.photo)} />}<div><h3>{p.title}</h3><p>{p.text}</p></div></article>)}</div></div></section>
<section class="section alt" id="programma"><div class="container"><div class="section-head"><p class="kicker">Un’idea da personalizzare</p><h2>Come distribuire il tempo</h2><p>Le visite si scelgono anche in base a meteo, mobilità e aperture. Il programma resta flessibile.</p></div><div class="grid-3">{g.days.map(d => <article class="card"><h3>{d.title}</h3><p>{d.text}</p></article>)}</div></div></section>
<section class="section" id="dormire"><div class="container"><div class="section-head"><p class="kicker">Scegliere la base</p><h2>Dove dormire: le zone da confrontare</h2><p>La scelta dell’hotel parte dal percorso: posizione, accesso con i bagagli e serate contano quanto la camera.</p></div><div class="grid-3">{g.stay.map(s => <article class="card"><h3>{s.title}</h3><p>{s.text}</p></article>)}</div></div></section>
<section class="section alt" id="consigli"><div class="container jp-two"><div><p class="kicker">Prima di partire</p><h2>Consigli per una visita più piacevole</h2><ul class="jp-tips">{g.tips.map(t => <li>{t}</li>)}</ul></div><aside class="card"><h3>Trasporti, budget e preparativi</h3><p>Dopo aver scelto i luoghi, valuta spostamenti, bagagli, connessione e budget dell’intero viaggio.</p><a href={`${base}giappone-pratico/`}>Leggi la guida pratica →</a><p><a href={`${base}primo-viaggio-giappone/`}>Costruisci il tuo primo itinerario →</a></p></aside></div></section>
<section class="section" id="domande"><div class="container"><h2>Le domande prima di scegliere</h2>{g.faq.map(f => <details class="jp-faq"><summary>{f.title}</summary><p>{f.text}</p></details>)}<div class="jp-sources"><h3>Fonti e verifiche per la partenza</h3><p>Informazioni sui luoghi verificate il 9 ottobre 2026. Durate, sequenze e zone di soggiorno sono suggerimenti di Davide. Per orari, biglietti, accessi e servizi consulta i siti ufficiali vicino alla partenza.</p><ul>{g.sources.map(s => <li><a href={s[1]} target="_blank" rel="noopener noreferrer">{s[0]}</a></li>)}</ul>{g.photo === 'nara' && <p>Foto di Nara: <a href="https://commons.wikimedia.org/wiki/File:20190121_Nara_deer-3.jpg">Balon Greyjoy · CC0</a>.</p>}</div></div></section>
<section class="section alt"><div class="container"><div class="section-head"><p class="kicker">Continua il viaggio</p><h2>Continua a conoscere il territorio</h2></div><div class="jp-related"><a class="card" href={`${base}cosa-vedere-tokyo/`}>Tokyo →</a>{related.map(x => <a class="card" href={`${base}${x.slug}/`}>{x.name} →</a>)}</div></div></section>
<section class="section"><div class="container"><div class="cta"><div><p class="kicker">Dalle idee al tuo viaggio</p><h2>Quali tappe senti più tue?</h2><p>Raccontami periodo, giorni disponibili, partecipanti e luoghi che ti hanno colpito. Costruirò una proposta con un ritmo adatto a te.</p></div><a class="button button-primary" href={`${base}preventivo/?destinazione=Giappone&tipo=Tour%20culturale`}>Richiedi la tua proposta</a></div></div></section>
</BaseLayout>
<style>
.jp-guide-hero{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding:65px 0}.jp-guide-hero h1{font-size:clamp(2.1rem,4.5vw,3.6rem)}.jp-two{display:grid;grid-template-columns:1fr 1fr;gap:26px}.jp-summary h2{font-size:1.7rem}.jp-jump{display:flex;flex-wrap:wrap;gap:12px}.jp-jump a{padding:12px 18px;border:1px solid var(--line);border-radius:30px;text-decoration:none;background:white}.jp-places{display:grid;gap:24px}.jp-place h3{font-size:1.65rem}.jp-place p{line-height:1.85;margin-bottom:0}.jp-place-photo{display:grid;grid-template-columns:.8fr 1.2fr;gap:32px;align-items:center}.jp-place-photo :global(figure){margin:0}.jp-place-photo :global(img){width:100%;height:300px;object-fit:cover}.jp-tips{padding-left:22px}.jp-tips li{margin:0 0 18px;line-height:1.8}.jp-faq{padding:20px 0;border-bottom:1px solid var(--line)}.jp-faq summary{cursor:pointer;font-weight:800}.jp-faq p{max-width:850px}.jp-sources{margin-top:38px;font-size:.94rem;color:var(--muted)}.jp-related{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.jp-related a{text-decoration:none;font-weight:800}section[id]{scroll-margin-top:110px}
@media(max-width:900px){.jp-guide-hero,.jp-two,.jp-place-photo{grid-template-columns:1fr}.jp-guide-hero{gap:24px}.jp-related{grid-template-columns:1fr 1fr}.jp-place-photo :global(img){height:280px}}
@media(max-width:560px){.jp-related{grid-template-columns:1fr}.jp-jump a{flex:1 1 42%;text-align:center}.jp-guide-hero{padding:40px 0}.jp-place{padding:24px}}
</style>
