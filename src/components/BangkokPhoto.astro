---
import { bangkokPhotos, type BangkokPhotoKey } from '../data/bangkokPhotos';
interface Props { photo: BangkokPhotoKey; variant?: 'card' | 'hero' | 'wide'; }
const { photo, variant = 'card' } = Astro.props;
const item = bangkokPhotos[photo];
const base = import.meta.env.BASE_URL;
---
<figure class={`bangkok-photo bangkok-photo--${variant}`}>
 <img src={`${base}images/${item.path}-1280.webp`} srcset={`${base}images/${item.path}-640.webp 640w, ${base}images/${item.path}-1280.webp 1280w`} sizes={variant === 'card' ? '(max-width: 900px) 92vw, 380px' : '(max-width: 900px) 92vw, 600px'} width={item.width} height={item.height} alt={item.alt} loading={variant === 'hero' ? 'eager' : 'lazy'} fetchpriority={variant === 'hero' ? 'high' : 'auto'} decoding="async" style={`object-position:${item.position}`} />
 <figcaption><a href={item.source}>{item.author} / Wikimedia Commons</a> · <a href={item.licenseUrl}>{item.license}</a> · formato adattato</figcaption>
</figure>
<style>
.bangkok-photo{margin:0;min-width:0}.bangkok-photo img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:20px}.bangkok-photo figcaption{margin-top:10px;font-size:.75rem;line-height:1.6;color:var(--muted);overflow-wrap:anywhere}.bangkok-photo figcaption a{color:inherit}.bangkok-photo--hero img{aspect-ratio:4/5;max-height:560px}.bangkok-photo--hero figcaption{color:#e5eaf0}.bangkok-photo--wide img{aspect-ratio:16/9}
@media(max-width:900px){.bangkok-photo--hero img{aspect-ratio:4/3;max-height:none}}
</style>
