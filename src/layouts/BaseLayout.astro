---
import '../styles/global.css';

const {
  title = 'Davide Fois Travel Consultant',
  description = 'Viaggi su misura con assistenza personale prima, durante e dopo la partenza.',
  image = `${import.meta.env.BASE_URL}og-image.svg`,
  noindex = false,
  schema = null
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
const gaId = import.meta.env.PUBLIC_GA_ID;
const searchConsoleCode = import.meta.env.PUBLIC_SEARCH_CONSOLE_CODE;

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": "Davide Fois Travel Consultant",
  "url": new URL(base, Astro.site).href,
  "description": description,
  "areaServed": "IT",
  "sameAs": ["https://davidefois.nuovevacanze.it"],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "availableLanguage": ["Italian"]
  }
};
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0b1f3a" />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={`${base}favicon.svg`} />

  {searchConsoleCode && (
    <meta name="google-site-verification" content={searchConsoleCode} />
  )}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta property="og:locale" content="it_IT" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, Astro.site)} />

  <title>{title}</title>

  <script type="application/ld+json" set:html={JSON.stringify(schema ?? defaultSchema)} />

  {gaId && (
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        window.dataLayer.push(arguments);
      }

      window.trackEvent = function (eventName, parameters = {}) {
        if (typeof gtag === "function") {
          gtag("event", eventName, parameters);
        }
      };

      window.enableAnalytics = function () {
        if (window.__gaLoaded) return;

        window.__gaLoaded = true;

        const script = document.createElement("script");
        script.async = true;
        script.src =
          "https://www.googletagmanager.com/gtag/js?id=" +
          encodeURIComponent(gaId);

        document.head.appendChild(script);

        gtag("js", new Date());
        gtag("config", gaId, {
          anonymize_ip: true,
          page_path: window.location.pathname,
          send_page_view: true
        });
      };
    </script>
  )}
</head>

<body>
<a class="skip-link" href="#main-content">Vai al contenuto</a>
<header class="site-header">
  <div class="container nav">
    <a class="brand" href={base}>
      <span class="brand-mark">DF</span>
      <span class="brand-copy">
        Davide Fois
        <small>Travel Consultant • Powered by Nuovevacanze</small>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">Menu</button>
    <nav class="nav-links" id="main-navigation" aria-label="Navigazione principale">
      <a href={`${base}chi-sono/`}>Chi sono</a>
      <a href={`${base}consulente-viaggi/`}>Consulenza</a>
      <a href={`${base}destinazioni/`}>Destinazioni</a>
      <a href={`${base}blog/`}>Guide</a>
      <a class="button button-dark" href={`${base}preventivo/`}>Richiedi preventivo</a>
    </nav>
  </div>
</header>

<main id="main-content"><slot /></main>

<a
  class="whatsapp"
  id="whatsapp-link"
  aria-label="Contattami su WhatsApp"
  href="https://wa.me/393389028812?text=Buongiorno%20Davide,%20vorrei%20informazioni%20per%20un%20viaggio."
  target="_blank"
  rel="noopener noreferrer"
><svg aria-hidden="true" viewBox="0 0 32 32" width="35" height="35" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M16 .8A15.12 15.12 0 0 0 2.91 23.47L.8 31.2l7.92-2.08A15.2 15.2 0 1 0 16 .8Zm0 27.6a12.35 12.35 0 0 1-6.3-1.73l-.45-.27-4.7 1.23 1.25-4.58-.29-.47A12.42 12.42 0 1 1 16 28.4Zm6.82-9.3c-.37-.19-2.18-1.08-2.52-1.2-.34-.13-.58-.19-.83.18-.25.37-.95 1.2-1.17 1.45-.21.24-.43.27-.8.08-.38-.18-1.57-.58-2.98-1.84-1.1-.98-1.85-2.19-2.06-2.56-.22-.37-.03-.57.16-.75.17-.17.37-.44.55-.65.18-.22.25-.37.37-.62.12-.24.06-.46-.03-.64-.1-.18-.83-2-1.14-2.74-.3-.71-.61-.61-.83-.62h-.71c-.25 0-.65.1-.99.46-.34.37-1.29 1.26-1.29 3.07s1.32 3.55 1.51 3.79c.18.25 2.59 3.96 6.28 5.55.88.38 1.57.61 2.1.78.89.28 1.7.24 2.34.15.71-.1 2.18-.89 2.49-1.75.31-.86.31-1.6.22-1.75-.1-.16-.34-.25-.71-.43Z"/></svg></a>

<div class="cookie-banner" id="cookie-banner" hidden>
  <div>
    <strong>Cookie e misurazione</strong>
    <p>Usiamo strumenti di misurazione solo dopo il tuo consenso. Puoi accettare oppure continuare senza analytics.</p>
  </div>
  <div class="cookie-actions">
    <button class="button button-primary" id="accept-analytics">Accetta</button>
    <button class="button button-secondary" id="reject-analytics">Rifiuta</button>
  </div>
</div>

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <strong>Davide Fois Travel Consultant</strong>
      <p>Consulenza personalizzata e accesso alle proposte Nuovevacanze.</p>
    </div>
    <div>
      <strong>Esplora</strong><br />
      <a href={`${base}destinazioni/`}>Destinazioni</a><br />
      <a href={`${base}destinazioni/asia/`}>Asia</a> · <a href={`${base}destinazioni/europa/`}>Europa</a><br />
      <a href={`${base}destinazioni/africa/`}>Africa</a> · <a href={`${base}destinazioni/americhe/`}>Americhe</a> · <a href={`${base}destinazioni/oceania/`}>Oceania</a><br />
      <a href={`${base}blog/`}>Guide</a><br />
      <a href={`${base}preventivo/`}>Preventivo</a>
    </div>
    <div>
      <strong>Informazioni</strong><br />
      <a href={`${base}privacy/`}>Privacy</a><br />
      <a href={`${base}cookie-policy/`}>Cookie</a><br />
      <a id="catalog-link" href="https://davidefois.nuovevacanze.it" target="_blank" rel="noopener noreferrer">Catalogo Nuovevacanze</a>
    </div>
  </div>
</footer>

<script is:inline>
  const menuButton = document.querySelector('.menu-toggle');
  const menu = document.getElementById('main-navigation');
  function closeMenu() { menuButton?.setAttribute('aria-expanded', 'false'); menu?.classList.remove('is-open'); }
  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') !== 'true';
    menuButton.setAttribute('aria-expanded', String(open)); menu?.classList.toggle('is-open', open);
  });
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') { closeMenu(); menuButton.focus(); } });
  menu?.addEventListener('click', event => { if (event.target.closest('a')) closeMenu(); });
  const banner = document.getElementById("cookie-banner");
  const savedConsent = localStorage.getItem("analytics-consent");

  if (!savedConsent) banner.hidden = false;

  if (savedConsent === "accepted" && window.enableAnalytics) {
    window.enableAnalytics();
  }

  document.getElementById("accept-analytics")?.addEventListener("click", () => {
    localStorage.setItem("analytics-consent", "accepted");
    banner.hidden = true;
    window.enableAnalytics?.();
  });

  document.getElementById("reject-analytics")?.addEventListener("click", () => {
    localStorage.setItem("analytics-consent", "rejected");
    banner.hidden = true;
  });

  document.getElementById("whatsapp-link")?.addEventListener("click", () => {
    window.trackEvent?.("click_whatsapp", {
      link_url: "https://wa.me/393389028812",
      page_path: window.location.pathname
    });
  });

  document.getElementById("catalog-link")?.addEventListener("click", () => {
    window.trackEvent?.("click_catalogo_nuovevacanze", {
      link_url: "https://davidefois.nuovevacanze.it",
      page_path: window.location.pathname
    });
  });
</script>
</body>
</html>
