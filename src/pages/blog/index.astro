---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const guides = [
 {name: "Il Giappone per regioni", area: "Asia · Giappone", text: "Dieci aree turistiche, 47 prefetture e guide di località per scegliere città, cultura e natura.", path: "giappone/regioni/"},
 {name: "Tokyo e il Kanto", area: "Asia · Giappone", text: "Città, santuari, costa, giardini, montagne e terme nelle sette prefetture del Kanto.", path: "giappone/regioni/kanto/"},
 {"name": "Primo viaggio in Giappone", "area": "Asia · Giappone", "text": "Sei guide illustrate e percorsi di 10 e 14 giorni per scegliere le tappe.", "path": "primo-viaggio-giappone/"},
 {"name": "Kyoto: luoghi e consigli", "area": "Asia · Giappone", "text": "Per chi cerca cultura, architettura e un Giappone da scoprire a piedi.", "path": "cosa-vedere-kyoto/"},
 {"name": "Osaka: luoghi e consigli", "area": "Asia · Giappone", "text": "Per chi vuole alternare cultura, cucina e vita cittadina.", "path": "cosa-vedere-osaka/"},
 {"name": "Nara: luoghi e consigli", "area": "Asia · Giappone", "text": "Per chi ama storia, templi e passeggiate, con tempi adattabili anche alle famiglie.", "path": "cosa-vedere-nara/"},
 {"name": "Monte Fuji e Hakone: luoghi e consigli", "area": "Asia · Giappone", "text": "Per chi desidera paesaggi, ospitalità tradizionale o terme, con aspettative realistiche sul meteo.", "path": "monte-fuji-hakone/"},
 {"name": "Hiroshima e Miyajima: luoghi e consigli", "area": "Asia · Giappone", "text": "Per chi vuole includere storia contemporanea e una tappa sul mare nel Giappone occidentale.", "path": "hiroshima-miyajima/"},

 { name: 'Mare in Thailandia: Phuket, Krabi o Koh Samui?', area: 'Asia · Thailandia', text: 'Spiagge, periodo, zone dove dormire ed escursioni: confronta le tre mete.', path: 'mare-thailandia-phuket-krabi-koh-samui/' },
 { name: 'Chiang Mai e il nord della Thailandia', area: 'Asia · Thailandia', text: 'Templi, quartieri, escursioni e idee per 3–5 giorni. Quando aggiungere Chiang Rai e Pai.', path: 'cosa-vedere-chiang-mai/' },
 { name: 'Bangkok: luoghi, quartieri ed escursioni', area: 'Asia · Thailandia', text: 'Cosa vedere, quanti giorni, dove dormire e un’idea di programma per la capitale.', path: 'cosa-vedere-bangkok/' },
 { name: 'Giappone: guide e itinerari', area: 'Asia', text: 'Stagioni, Tokyo, Kyoto, Osaka e itinerari da personalizzare.', path: 'giappone/' },
 { name: 'Giappone pratico', area: 'Asia · dalla mia guida', text: 'Durata, budget, trasporti, Internet e checklist di partenza.', path: 'giappone-pratico/' },
 { name: 'Giappone in autunno', area: 'Asia', text: 'Ispirazioni e tappe per un viaggio tra i colori autunnali.', path: 'blog/giappone-in-autunno/' },
 { name: 'Weekend a Vilnius', area: 'Europa', text: 'Centro storico, Užupis e Trakai.', path: 'blog/weekend-a-vilnius/' }
];
---
<BaseLayout title="Guide e ispirazioni di viaggio | Davide Fois" description="Le guide disponibili per iniziare a organizzare il viaggio e un accesso alle destinazioni nel mondo.">
<section class="page"><div class="container"><div class="section-head"><p class="kicker">Guide di viaggio</p><h1>Informazioni utili prima di partire.</h1><p>Qui trovi gli approfondimenti già disponibili. Per esplorare tutte le aree e chiedere una proposta, parti dalle destinazioni.</p></div><div class="grid-3">{guides.map(guide => <article class="card"><p class="kicker">{guide.area}</p><h2 style="font-size:1.7rem">{guide.name}</h2><p>{guide.text}</p><a href={`${base}${guide.path}`}>Leggi la guida →</a></article>)}</div><div class="actions"><a class="button button-dark" href={`${base}destinazioni/`}>Esplora tutti i continenti</a></div></div></section>
</BaseLayout>
