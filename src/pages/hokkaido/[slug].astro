---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hokkaidoPlaces } from '../../data/hokkaidoPlaces';
export function getStaticPaths(){return hokkaidoPlaces.map(place=>({params:{slug:place.slug},props:{place}}));}
const {place}=Astro.props;
const base=import.meta.env.BASE_URL;
const photoUrl=(filename:string)=>`https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(filename)}?width=1280`;
---
<BaseLayout title={`${place.name}: cosa vedere in Hokkaido | D. Fois Travel`} description={`${place.summary} Idee, tappe, stagioni e consigli di viaggio.`}>
<section class="hero"><div class="container hk-detail-hero"><div><p class="kicker"><a href={`${base}hokkaido/`}>Hokkaido</a> · {place.area}</p><h1>{place.name}</h1><p class="lead">{place.summary}</p><div class="actions"><a class="button button-primary" href="#luoghi">Cosa vedere</a><a class="button button-ghost" href={`${base}hokkaido/`}>Tutte le guide di Hokkaido</a></div></div>{place.photo && <figure><img src={photoUrl(place.photo)} alt={place.name} loading="eager" decoding="async"/><figcaption>Fotografia: {place.credit} · <a href={`https://commons.wikimedia.org/wiki/File:${encodeURIComponent(place.photo)}`} target="_blank" rel="noopener noreferrer">immagine e condizioni di riutilizzo su Wikimedia Commons</a></figcaption></figure>}</div></section>
<section class="section" id="luoghi"><div class="container"><div class="section-head"><p class="kicker">I luoghi essenziali</p><h2>Tre esperienze da considerare</h2><p>Non sono necessariamente tappe della stessa giornata: scegli in funzione dei collegamenti e della stagione.</p></div><div class="grid-3">{place.spots.map(spot=><article class="card"><h3>{spot[0]}</h3><p>{spot[1]}</p></article>)}</div></div></section>
<section class="section alt"><div class="container hk-tips"><article class="card"><h3>Quanto tempo dedicare</h3><p>{place.days}</p><h3>Quando andare</h3><p>{place.season}</p></article><article class="card"><h3>Come organizzare</h3><p>{place.tip}</p><p>Verifica orari aggiornati, disponibilità dei trasporti e condizioni di accesso prima della partenza.</p></article></div></section>
<section class="section"><div class="container"><div class="cta"><div><p class="kicker">Un viaggio pensato per te</p><h2>Vuoi includere {place.name} nel tuo itinerario?</h2><p>Confrontiamo periodo, budget e tempi di viaggio per costruire un percorso coerente.</p></div><a class="button button-primary" href={`${base}preventivo/?destinazione=Hokkaido`}>Richiedi una proposta</a></div><p class="hk-source">Fonti territoriali: <a href={place.source} rel="noopener noreferrer" target="_blank">turismo ufficiale</a>. Le esperienze stagionali possono variare.</p><p><a href={`${base}hokkaido/`}>← Torna alla guida Hokkaido</a></p></div></section>
</BaseLayout>
<style>.hk-detail-hero{padding:60px 0;display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:center}.hk-detail-hero:has(>div:only-child){grid-template-columns:1fr}.hk-detail-hero figure{margin:0}.hk-detail-hero img{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:22px}.hk-detail-hero figcaption{font-size:.75rem;color:#e1e6eb;margin-top:8px}.hk-tips{display:grid;grid-template-columns:1fr 1fr;gap:22px}.hk-source{font-size:.85rem;color:var(--muted);margin:22px 0}@media(max-width:800px){.hk-detail-hero,.hk-tips{grid-template-columns:1fr}}</style>
