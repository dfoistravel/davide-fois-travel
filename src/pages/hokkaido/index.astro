---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hokkaidoPlaces } from '../../data/hokkaidoPlaces';
const base=import.meta.env.BASE_URL;
const photoUrl=(filename:string)=>`https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(filename)}?width=1280`;
---
<BaseLayout title="Hokkaido: guida completa del nord del Giappone | D. Fois Travel" description="Hokkaido: Sapporo, Otaru, Hakodate, Furano, Biei, Shiretoko e parchi naturali. Guide, stagioni, itinerari e consigli pratici.">
<section class="hero"><div class="container hk-hero"><p class="kicker"><a href={`${base}giappone/regioni/`}>Regioni del Giappone</a> · Hokkaido</p><h1>Hokkaido, il Giappone dei grandi spazi.</h1><p class="lead">Città vivaci, piccoli porti, terme vulcaniche e parchi selvaggi: scopri l'isola più settentrionale del Giappone, zona dopo zona, senza affrettare gli spostamenti.</p><div class="actions"><a class="button button-primary" href="#tappe">Esplora le destinazioni</a><a class="button button-ghost" href="#itinerari">Come organizzare il viaggio</a></div></div></section>
<section class="section" id="tappe"><div class="container"><div class="section-head"><p class="kicker">Otto guide territoriali</p><h2>Città, natura e luoghi meno conosciuti</h2><p>Hokkaido è molto estesa: scegli poche zone e lascia tempo agli spostamenti. Ogni guida contiene tappe, durata consigliata e periodo migliore.</p></div><div class="hk-grid">{hokkaidoPlaces.map(item=><article class="card hk-card">{item.photo && <img src={photoUrl(item.photo)} alt={item.name} loading="lazy" decoding="async" />}<div class="hk-cardbody"><p class="kicker">{item.area} · {item.days}</p><h3>{item.name}</h3><p>{item.summary}</p><a class="button button-dark" href={`${base}hokkaido/${item.slug}/`}>Scopri la guida →</a></div></article>)}</div></div></section>
<section class="section alt" id="itinerari"><div class="container"><div class="section-head"><p class="kicker">Un'isola, più viaggi possibili</p><h2>Tre idee di itinerario</h2></div><div class="grid-3"><article class="card"><h3>5–7 giorni · Primo assaggio</h3><p>Sapporo, Otaru e una zona fra Noboribetsu/Lago Toya o Furano/Biei. Evita l'estremo est.</p></article><article class="card"><h3>9–12 giorni · Città e paesaggi</h3><p>Una selezione di Sapporo, Hakodate, Noboribetsu e Furano/Biei, verificando bene i trasferimenti.</p></article><article class="card"><h3>12–16 giorni · Natura orientale</h3><p>Itinerario dedicato a Kushiro, Akan-Mashu e Shiretoko con pernottamenti intermedi, preferibilmente auto o servizi organizzati.</p></article></div></div></section>
<section class="section"><div class="container"><div class="hk-info"><div class="card"><h3>Quando andare</h3><p><strong>Giugno–agosto:</strong> verde, trekking, fiori e lavanda nel periodo adatto. <strong>Settembre–ottobre:</strong> foliage prima nelle aree montane. <strong>Dicembre–marzo:</strong> neve, sci e alcuni festival; ghiaccio marino in periodi e condizioni variabili.</p></div><div class="card"><h3>Trasporti e cultura</h3><p>Arrivo frequente dall'aeroporto New Chitose vicino a Sapporo. Treni e autobus per centri principali; per est e parchi naturali conviene valutare auto o escursioni. Scopri le tradizioni delle comunità ainu con visite rispettose e iniziative gestite localmente.</p></div></div><div class="cta"><div><p class="kicker">Costruiamo il tuo Hokkaido</p><h2>Un itinerario su misura, non una corsa.</h2><p>Indicami stagione, giorni e interessi: natura, città, terme, cultura o sci.</p></div><a class="button button-primary" href={`${base}preventivo/?destinazione=Hokkaido`}>Richiedi una proposta</a></div><p class="hk-source">Informazioni territoriali: <a href="https://www.japan.travel/en/destinations/hokkaido/hokkaido/">JNTO</a> e <a href="https://www.visit-hokkaido.jp/en/spot/index.html">Hokkaido Tourism Organization</a>. Fotografie esterne da Wikimedia Commons, con autori e licenze indicati nelle singole guide.</p></div></section>
</BaseLayout>
<style>.hk-hero{padding:68px 0 64px;max-width:1060px}.hk-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px}.hk-card{padding:0;overflow:hidden;display:flex;flex-direction:column}.hk-card img{width:100%;aspect-ratio:16/9;object-fit:cover}.hk-cardbody{padding:26px;display:flex;flex-direction:column;flex:1}.hk-cardbody .button{align-self:start;margin-top:auto}.hk-info{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-bottom:36px}.hk-source{font-size:.88rem;color:var(--muted);margin-top:24px}@media(max-width:700px){.hk-grid,.hk-info{grid-template-columns:1fr}.hk-hero{padding:42px 0}}</style>
