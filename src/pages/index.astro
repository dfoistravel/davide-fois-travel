---
import JapanPhoto from '../components/JapanPhoto.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContinentGrid from '../components/ContinentGrid.astro';
const base = import.meta.env.BASE_URL;
const continents = [
  { name: 'Asia', image: 'https://images.pexels.com/photos/402028/pexels-photo-402028.jpeg?auto=compress&cs=tinysrgb&w=2000', fallback: 'asia.webp' },
  { name: 'Europa', image: 'https://images.pexels.com/photos/338515/pexels-photo-338515.jpeg?auto=compress&cs=tinysrgb&w=2000', fallback: 'europa.webp' },
  { name: 'Africa', image: 'https://images.pexels.com/photos/247376/pexels-photo-247376.jpeg?auto=compress&cs=tinysrgb&w=2000', fallback: 'africa.webp' },
  { name: 'Americhe', image: 'https://images.pexels.com/photos/466685/pexels-photo-466685.jpeg?auto=compress&cs=tinysrgb&w=2000', fallback: 'americhe.webp' },
  { name: 'Oceania', image: 'https://images.pexels.com/photos/995764/pexels-photo-995764.jpeg?auto=compress&cs=tinysrgb&w=2000', fallback: 'oceania.webp' },
];
const experiences = ['Mare e relax', 'Tour culturale', 'Natura e avventura', 'Weekend e città', 'Viaggio di nozze', 'Crociera'];
---
<BaseLayout title="Davide Fois Travel Consultant | Viaggi su misura nel mondo" description="Consulenza personale per viaggi in Asia, Europa, Africa, Americhe e Oceania. Scegli una destinazione o lasciati aiutare: richiedi un preventivo gratuito.">
  <section class="hero world-hero tropical-hero world-fullscreen-hero" aria-label="Viaggi nei cinque continenti">
    <div class="world-slideshow" aria-hidden="true">
      {continents.map((continent, i) => <div class:list={['world-slide', { 'is-active': i === 0 }]} style={`background-image: url('${continent.image}'), url('${base}images/world-hero/${continent.fallback}')`}></div>)}
    </div>
    <div class="world-photo-overlay" aria-hidden="true"></div>
    <div class="container world-hero-grid">
    <div class="tropical-copy"><p class="kicker">Viaggi su misura · Emozioni autentiche</p><h1>Ci sono luoghi che sogni.<br /><span>E viaggi che ti cambiano.</span></h1><p class="lead"><span class="intro-desktop">Dalle meraviglie del Giappone alle spiagge tropicali, dalle grandi città agli angoli più nascosti del mondo. Raccontami cosa immagini: insieme troveremo il viaggio che parla davvero di te.</span><span class="intro-mobile">Dal Giappone alle spiagge tropicali: raccontami il viaggio che sogni e lo costruiremo insieme.</span></p><div class="actions"><a class="button button-primary" href={`${base}preventivo/`}>Iniziamo a progettare ↗</a><a class="button button-primary mobile-form-link" href="#mobile-trip-form">Crea il tuo viaggio ↓</a><a class="button button-ghost" href="#continenti">Lasciati ispirare →</a></div><div class="trust-row"><span>Un referente personale</span><span>Proposta su misura</span><span>Richiesta senza impegno</span></div></div>
    <aside class="world-start"><p class="kicker">Il tuo prossimo viaggio inizia qui</p><h2>Qual è la tua prossima avventura?</h2><p class="tropical-form-intro">Hai già una meta nel cuore? Oppure vuoi qualche idea? Partiamo dai tuoi desideri.</p><form action={`${base}preventivo/`} method="GET"><label for="quick-destination">Dove vorresti andare?<input id="quick-destination" name="destinazione" placeholder="Es. Giappone, Bali, Australia…" /></label><label for="quick-style">Che esperienza cerchi?<select id="quick-style" name="tipo"><option value="">Aiutami a scegliere</option>{experiences.map(experience => <option value={experience}>{experience}</option>)}</select></label><button class="button button-dark" type="submit">Costruiamo la tua proposta →</button></form><p>✦ Nessun impegno. La tua idea merita di essere ascoltata.</p></aside>
  </div>
    <nav class="world-slide-selector" aria-label="Seleziona il continente da visualizzare">
      {continents.map((continent, i) => <button class:list={['world-slide-button', { 'is-active': i === 0 }]} type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-world-slide={i}>{continent.name}</button>)}
    </nav>
    <span class="world-slide-caption" aria-live="off">Esplora Asia</span>
  </section>
  <section class="mobile-trip-section" id="mobile-trip-form" aria-labelledby="mobile-trip-title">
    <div class="container">
      <div class="mobile-trip-card">
        <p class="kicker">Il tuo prossimo viaggio inizia qui</p>
        <h2 id="mobile-trip-title">Dove vorresti andare?</h2>
        <p class="mobile-trip-intro">Hai già una meta in mente oppure cerchi ispirazione? Partiamo dai tuoi desideri.</p>
        <form action={`${base}preventivo/`} method="GET">
          <label for="mobile-quick-destination">La tua destinazione
            <input id="mobile-quick-destination" name="destinazione" placeholder="Es. Giappone, Bali, Australia…" autocomplete="off" />
          </label>
          <label for="mobile-quick-style">Che esperienza cerchi?
            <select id="mobile-quick-style" name="tipo">
              <option value="">Aiutami a scegliere</option>
              {experiences.map(experience => <option value={experience}>{experience}</option>)}
            </select>
          </label>
          <button class="button button-dark" type="submit">Richiedi la tua proposta →</button>
        </form>
        <p class="mobile-trip-note">Richiesta gratuita e senza impegno.</p>
      </div>
    </div>
  </section>
  <section class="section" id="continenti"><div class="container"><div class="section-head"><p class="kicker">Scegli un continente</p><h2>Cinque porte sul mondo.</h2><p>Esplora le mete e chiedi una proposta. Ogni viaggio prende forma intorno a te.</p></div><ContinentGrid /></div></section>
  <section class="section alt"><div class="container japan-feature"><JapanPhoto photo="miyajima" variant="wide" caption="Miyajima · fotografia dal mio viaggio in Giappone" /><div><p class="kicker">Destinazione in evidenza · Giappone</p><h2>Giappone, molto più di un viaggio.</h2><p>Templi millenari, metropoli futuristiche, villaggi tradizionali e sentieri tra le montagne. Scopri le guide dedicate alle regioni del Giappone e lasciati ispirare per costruire un itinerario davvero tuo.</p><div class="actions"><a class="button button-dark" href={`${base}giappone/`}>Esplora il Giappone</a><a class="text-link" href={`${base}giappone-pratico/`}>Consigli dalla guida →</a></div></div></div></section>
  <section class="section alt"><div class="container"><div class="section-head"><p class="kicker">Scegli un’esperienza</p><h2>Che cosa vuoi dal tuo prossimo viaggio?</h2></div><div class="experience-links">{experiences.map(experience => <a href={`${base}preventivo/?tipo=${encodeURIComponent(experience)}`}>{experience} <span aria-hidden="true">↗</span></a>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><p class="kicker">Come funziona</p><h2>Dalla tua idea alla partenza.</h2></div><div class="steps"><article class="step"><h3>Mi racconti</h3><p>Meta, periodo, budget e cosa vorresti vivere.</p></article><article class="step"><h3>Ti propongo</h3><p>Valutiamo un viaggio coerente con le tue esigenze.</p></article><article class="step"><h3>Lo definiamo</h3><p>Scegliamo insieme tappe, alloggi e servizi.</p></article><article class="step"><h3>Ti accompagno</h3><p>Resto il tuo riferimento prima, durante e dopo.</p></article></div><div class="actions"><a class="button button-dark" href={`${base}consulente-viaggi/`}>Scopri la consulenza</a><a class="text-link" href={`${base}chi-sono/`}>Conosci Davide →</a></div></div></section>
  <section class="section"><div class="container cta"><div><p class="kicker">Il prossimo passo</p><h2>Hai un’idea? Raccontamela.</h2><p>La richiesta iniziale è gratuita e senza obbligo di prenotazione.</p></div><a class="button button-primary" href={`${base}preventivo/`}>Richiedi il tuo preventivo</a></div></section>
</BaseLayout>

<script is:inline>
  (() => {
    const hero = document.querySelector('.world-fullscreen-hero');
    if (!hero) return;
    const slides = Array.from(hero.querySelectorAll('.world-slide'));
    const buttons = Array.from(hero.querySelectorAll('.world-slide-button'));
    const caption = hero.querySelector('.world-slide-caption');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;
    let timer;
    const setSlide = (next) => {
      active = (next + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === active));
      buttons.forEach((b, i) => { b.classList.toggle('is-active', i === active); b.setAttribute('aria-pressed', String(i === active)); });
      if (caption) caption.textContent = `Esplora ${buttons[active].textContent.trim()}`;
    };
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const play = () => {
      stop();
      if (reduced.matches || document.hidden) return;
      timer = window.setInterval(() => setSlide(active + 1), 5500);
    };
    buttons.forEach((button, index) => button.addEventListener('click', () => { setSlide(index); play(); }));
    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', play);
    hero.addEventListener('focusin', stop);
    hero.addEventListener('focusout', (event) => { if (!hero.contains(event.relatedTarget)) play(); });
    document.addEventListener('visibilitychange', () => document.hidden ? stop() : play());
    if (reduced.addEventListener) reduced.addEventListener('change', play);
    play();
  })();
</script>
