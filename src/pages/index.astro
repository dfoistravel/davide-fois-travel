---
import JapanPhoto from '../components/JapanPhoto.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContinentGrid from '../components/ContinentGrid.astro';
const base = import.meta.env.BASE_URL;
const slides = [
  { continent: 'Asia', place: 'Shibuya, Tokyo', image: `${base}images/tokyo/shibuya.webp` },
  { continent: 'Europa', place: 'Santorini, Grecia', image: 'https://upload.wikimedia.org/wikipedia/commons/thumb/0/0a/Blue-dome-Santorini.JPG/1280px-Blue-dome-Santorini.JPG' },
  { continent: 'Africa', place: 'Table Mountain, Sudafrica', image: 'https://commons.wikimedia.org/wiki/Special:FilePath/CapeTownFromTableMountain.jpg' },
  { continent: 'Americhe', place: 'Machu Picchu, Perù', image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Panorama%20of%20Machu%20Picchu.jpg' },
  { continent: 'Oceania', place: 'Sydney Opera House, Australia', image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Sydney%20Harbour%20Bridge%20and%20Sydney%20Opera%20House%20panorama.jpg' },
];
const continents = ['Asia', 'Europa', 'Africa', 'Americhe', 'Oceania'];
const experiences = ['Mare e relax', 'Tour culturale', 'Natura e avventura', 'Weekend e città', 'Viaggio di nozze', 'Crociera'];
---
<BaseLayout title="Davide Fois Travel Consultant | Viaggi su misura nel mondo" description="Consulenza personale per viaggi in Asia, Europa, Africa, Americhe e Oceania. Scegli una destinazione o lasciati aiutare: richiedi un preventivo gratuito.">
  <section class="hero world-hero tropical-hero world-fullscreen-hero" aria-label="Viaggi nei cinque continenti">
    <div class="world-slideshow" aria-hidden="true">
      {slides.map((slide, i) => <div class:list={['world-slide', { 'is-active': i === 0 }]} data-continent={slide.continent} style={`background-image: url('${slide.image}')`}><span class="world-slide-location">{slide.continent} · {slide.place}</span></div>)}
    </div>
    <div class="world-photo-overlay" aria-hidden="true"></div>
    <div class="container world-hero-grid">
      <div class="tropical-copy world-copy-only">
        <p class="kicker">Viaggi su misura · Il mondo ti aspetta</p>
        <h1>Ci sono luoghi che sogni.<br /><span>E viaggi che ti cambiano.</span></h1>
        <p class="lead"><span class="intro-desktop">Una carrellata di destinazioni suggestive da tutto il mondo per ispirare il tuo prossimo viaggio. Dall'Asia all'Oceania, passando per città iconiche, natura spettacolare e mari da sogno: raccontami che cosa ti emoziona e costruiremo insieme un itinerario davvero tuo.</span><span class="intro-mobile">Ispirati con una carrellata di luoghi spettacolari da tutto il mondo e raccontami il viaggio che sogni.</span></p>
        <div class="actions">
          <a class="button button-primary" href="#trip-form">Crea il tuo viaggio ↓</a>
          <a class="button button-ghost" href="#continenti">Lasciati ispirare →</a>
        </div>
        <div class="trust-row"><span>Un referente personale</span><span>Proposta su misura</span><span>Richiesta senza impegno</span></div>
      </div>
    </div>
    <nav class="world-slide-selector" aria-label="Seleziona il continente da visualizzare">
      {continents.map((continent, i) => <button class:list={['world-slide-button', { 'is-active': i === 0 }]} type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-world-target={continent}>{continent}</button>)}
    </nav>

  </section>

  <p style="font-size:.72rem;text-align:center;margin:4px 12px 8px;color:#536572">Foto Santorini: <a href="https://commons.wikimedia.org/wiki/File:Blue-dome-Santorini.JPG" rel="noopener noreferrer" target="_blank">Hhss8228</a> · <a href="https://creativecommons.org/licenses/by/3.0/" rel="noopener noreferrer" target="_blank">CC BY 3.0</a> · ridimensionata per la visualizzazione.</p>

  <section class="trip-planner-section" id="trip-form" aria-labelledby="trip-form-title">
    <div class="container trip-planner-grid">
      <div class="trip-planner-copy">
        <p class="kicker">Il tuo prossimo viaggio inizia qui</p>
        <h2 id="trip-form-title">Dimmi dove vuoi andare. Al resto pensiamo insieme.</h2>
        <p>Che tu abbia già una meta in mente oppure voglia solo un’idea da cui partire, compila i campi qui sotto: sarà il primo passo per creare una proposta pensata davvero su misura per te.</p>
        <ul class="trip-planner-points">
          <li>Meta, stile di viaggio e primi desideri</li>
          <li>Consulenza personale e senza fretta</li>
          <li>Richiesta gratuita e senza impegno</li>
        </ul>
      </div>
      <div class="trip-planner-card">
        <form action={`${base}preventivo/`} method="GET">
          <label for="quick-destination">Dove vorresti andare?
            <input id="quick-destination" name="destinazione" placeholder="Es. Giappone, Bali, Australia…" autocomplete="off" />
          </label>
          <label for="quick-style">Che esperienza cerchi?
            <select id="quick-style" name="tipo">
              <option value="">Aiutami a scegliere</option>
              {experiences.map(experience => <option value={experience}>{experience}</option>)}
            </select>
          </label>
          <button class="button button-dark" type="submit">Richiedi la tua proposta →</button>
        </form>
        <p class="trip-planner-note">✦ Nessun impegno. La tua idea di viaggio merita di essere ascoltata.</p>
      </div>
    </div>
  </section>

<section class="section" id="continenti"><div class="container"><div class="section-head"><p class="kicker">Scegli un continente</p><h2>Cinque porte sul mondo.</h2><p>Esplora le mete e chiedi una proposta. Ogni viaggio prende forma intorno a te.</p></div><ContinentGrid /></div></section>
  <section class="section alt"><div class="container japan-feature"><JapanPhoto photo="miyajima" variant="wide" caption="Miyajima · fotografia dal mio viaggio in Giappone" /><div><p class="kicker">Destinazione in evidenza · Giappone</p><h2>Giappone, molto più di un viaggio.</h2><p>Templi millenari, metropoli futuristiche, villaggi tradizionali e sentieri tra le montagne. Scopri le guide dedicate alle regioni del Giappone e lasciati ispirare per costruire un itinerario davvero tuo.</p><div class="actions"><a class="button button-dark" href={`${base}giappone/`}>Esplora il Giappone</a><a class="text-link" href={`${base}giappone-pratico/`}>Consigli dalla guida →</a></div></div></div></section>
  <section class="section alt"><div class="container"><div class="section-head"><p class="kicker">Scegli un’esperienza</p><h2>Che cosa vuoi dal tuo prossimo viaggio?</h2></div><div class="experience-links">{experiences.map(experience => <a href={`${base}preventivo/?tipo=${encodeURIComponent(experience)}`}>{experience} <span aria-hidden="true">↗</span></a>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><p class="kicker">Come funziona</p><h2>Dalla tua idea alla partenza.</h2></div><div class="steps"><article class="step"><h3>Mi racconti</h3><p>Meta, periodo, budget e cosa vorresti vivere.</p></article><article class="step"><h3>Ti propongo</h3><p>Valutiamo un viaggio coerente con le tue esigenze.</p></article><article class="step"><h3>Lo definiamo</h3><p>Scegliamo insieme tappe, alloggi e servizi.</p></article><article class="step"><h3>Ti accompagno</h3><p>Resto il tuo riferimento prima, durante e dopo.</p></article></div><div class="actions"><a class="button button-dark" href={`${base}consulente-viaggi/`}>Scopri la consulenza</a><a class="text-link" href={`${base}chi-sono/`}>Conosci Davide →</a></div></div></section>
  <section class="section"><div class="container cta"><div><p class="kicker">Il prossimo passo</p><h2>Hai un’idea? Raccontamela.</h2><p>La richiesta iniziale è gratuita e senza obbligo di prenotazione.</p></div><a class="button button-primary" href={`${base}preventivo/`}>Richiedi il tuo preventivo</a></div></section>

</BaseLayout>

<script is:inline>
  (() => {
    const hero = document.querySelector('.world-fullscreen-hero');
    if (!hero) return;
    const slides = Array.from(hero.querySelectorAll('.world-slide'));
    const buttons = Array.from(hero.querySelectorAll('.world-slide-button'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;
    let timer;
    const setSlide = (next) => {
      active = (next + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === active));
      const current = slides[active];
      const currentContinent = current?.dataset.continent || '';
      buttons.forEach((button) => {
        const isCurrent = button.dataset.worldTarget === currentContinent;
        button.classList.toggle('is-active', isCurrent);
        button.setAttribute('aria-pressed', String(isCurrent));
      });

    };
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const play = () => {
      stop();
      if (reduced.matches || document.hidden) return;
      timer = window.setInterval(() => setSlide(active + 1), 7000);
    };
    buttons.forEach((button) => button.addEventListener('click', () => {
      const target = button.dataset.worldTarget;
      const index = slides.findIndex((slide) => slide.dataset.continent === target);
      if (index >= 0) setSlide(index);
      play();
    }));
    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', play);
    hero.addEventListener('focusin', stop);
    hero.addEventListener('focusout', (event) => { if (!hero.contains(event.relatedTarget)) play(); });
    document.addEventListener('visibilitychange', () => document.hidden ? stop() : play());
    if (reduced.addEventListener) reduced.addEventListener('change', play);
    setSlide(0);
    play();
  })();
</script>
