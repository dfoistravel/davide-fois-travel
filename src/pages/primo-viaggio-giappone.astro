---
import BaseLayout from '../layouts/BaseLayout.astro';
import JapanPhoto from '../components/JapanPhoto.astro';
import { kantoGuides } from "../data/kantoGuides";
import { japanGuides } from '../data/japanGuides';
const base = import.meta.env.BASE_URL;
const routes = [
 {title:'10 giorni · Tokyo e Kyoto con un’escursione', intro:'Esempio di 9 notti: 4 a Tokyo e 5 a Kyoto. Nara oppure Osaka sono una scelta per il giorno 9. Per visitarle entrambe, riduci una parte di Kyoto o aggiungi tempo.', rows:[
 ['1','Arrivo a Tokyo','Riposo, check-in e passeggiata leggera.'],
 ['2–4','Tokyo','Tre giornate piene: quartieri vicini, pause e una scelta tra musei, baia e shopping.'],
 ['5','Tokyo → Kyoto','Trasferimento e primo orientamento: non è una giornata intera di visite.'],
 ['6–8','Kyoto','Tre giornate per est, ovest e Fushimi / centro.'],
 ['9','Nara oppure Osaka','Una giornata da scegliere in base a cultura, cucina e interessi.'],
 ['10','Partenza dal Kansai','Trasferimento verso l’aeroporto, con margine adeguato.']]},
 {title:'14 giorni · Il classico con un’estensione a ovest',intro:'Esempio di 13 notti: 4 Tokyo, 1 Hakone oppure Kawaguchiko, 5 Kyoto, 2 Hiroshima, 1 Osaka. Osaka ha un pomeriggio e una sera: per dedicarle una giornata piena o per avere più tempo a Hiroshima, elimina la pausa Fuji / Hakone oppure aggiungi giorni.', rows:[
 ['1–4','Tokyo','Arrivo e tre giornate piene nella capitale.'],
 ['5','Hakone oppure Kawaguchiko','Trasferimento, una visita e pernottamento. Scegli una sola zona.'],
 ['6','Verso Kyoto','Spostamento e programma leggero dopo l’arrivo.'],
 ['7–9','Kyoto','Tre giornate dedicate a templi, quartieri e giardini.'],
 ['10','Nara','Escursione dalla base di Kyoto, senza cambio hotel.'],
 ['11','Kyoto → Hiroshima','Trasferimento e visita in base all’ora di arrivo. Se il museo è prioritario, preserva il tempo necessario.'],
 ['12','Miyajima','Giornata sull’isola e rientro a Hiroshima; un pernottamento sull’isola richiede di riorganizzare il percorso.'],
 ['13','Hiroshima → Osaka','Trasferimento e pomeriggio / sera a Osaka.'],
 ['14','Partenza dal Kansai','Verifica orario del volo e distanza dall’aeroporto.']]}
];
---
<BaseLayout title="Primo viaggio in Giappone: tappe e itinerari | Davide Fois" description="Sei guide illustrate, percorsi di 10 e 14 giorni ed esperienze da scegliere per il tuo primo viaggio in Giappone.">
<section class="hero"><div class="container first-hero"><div><p class="kicker"><a href={`${base}giappone/`}>Giappone</a> · Da dove iniziare</p><h1>Il tuo primo Giappone, una scelta alla volta.</h1><p class="lead">Prima di parlare di hotel e preventivi, scopri quale Giappone ti incuriosisce: quartieri contemporanei, templi, cucina, paesaggi o una notte in un ryokan. Qui puoi conoscere le tappe e capire come combinarle.</p><div class="actions"><a class="button button-primary" href="#tappe">Conosci le destinazioni</a><a class="button button-ghost" href="#percorsi">Confronta i percorsi</a></div></div><JapanPhoto photo="sensoji" variant="hero" eager caption="Tokyo · Sensō-ji, fotografia di Davide Fois" /></div></section>
<section class="section" id="tappe"><div class="container"><div class="section-head"><p class="kicker">Le guide da leggere</p><h2>Sei tappe per iniziare a conoscere il Giappone</h2><p>Parti dalle fotografie e apri gli approfondimenti: luoghi, idee di visita e consigli per scegliere la base.</p></div><div class="grid-3"><article class="card"><JapanPhoto photo="shibuya" /><h3>Tokyo</h3><p>Tradizione e vita urbana: Asakusa, Shibuya, quartieri, musei e baia.</p><a href={`${base}cosa-vedere-tokyo/`}>Esplora Tokyo →</a></article>{japanGuides.filter(g => !kantoGuides.some(k => k.slug === g.slug)).map(g => <article class="card"><JapanPhoto photo={g.photo} /><h3>{g.name}</h3><p>{g.fit}</p><p><strong>Tempo consigliato:</strong> {g.duration}.</p><a href={`${base}${g.slug}/`}>Leggi la guida →</a></article>)}</div><p class="credits">Fotografie di Davide Fois, tranne Nara: <a href="https://commons.wikimedia.org/wiki/File:20190121_Nara_deer-3.jpg">Balon Greyjoy, CC0</a>.</p></div></section>
<section class="section"><div class="container"><div class="seo-note"><strong>Vuoi esplorare oltre il primo percorso?</strong><p><a href={`${base}giappone/regioni/`}>Scopri il Giappone per regioni</a>: dalle città ai piccoli centri, dalla natura ai soggiorni termali.</p></div></div></section>
<section class="section alt"><div class="container"><div class="section-head"><p class="kicker">La tua esperienza</p><h2>Che cosa vuoi portare a casa dal viaggio?</h2></div><div class="grid-3"><article class="card"><h3>Cultura e passeggiate</h3><p>Dai più spazio a Kyoto e Nara. Alterna grandi templi a quartieri e giardini, lasciando pause per osservare e capire ciò che visiti.</p></article><article class="card"><h3>Cucina e città</h3><p>Tokyo e Osaka offrono occasioni per esplorare quartieri e mangiare in modi diversi. Segnala gusti, allergie ed esigenze alimentari quando prepariamo la proposta.</p></article><article class="card"><h3>Una notte diversa</h3><p>Un ryokan può dare spazio a ospitalità, cena e terme. Scegliamo la struttura verificando camera, pasti, regole degli onsen e orario d’arrivo.</p></article></div></div></section>
<section class="section" id="percorsi"><div class="container"><div class="section-head"><p class="kicker">Giorni e ritmo</p><h2>Due basi di partenza, da adattare a te</h2><p>Gli esempi contano i giorni di calendario in Giappone, incluso arrivo e partenza. La durata totale dalla partenza da casa può essere maggiore. Sono idee di itinerario da personalizzare.</p></div>{routes.map(r => <div class="route-block"><h3>{r.title}</h3><p>{r.intro}</p><div class="table-wrap" tabindex="0" aria-label={r.title}><table><thead><tr><th scope="col">Giorni</th><th scope="col">Tappa</th><th scope="col">Come usarli</th></tr></thead><tbody>{r.rows.map(row => <tr>{row.map(c => <td>{c}</td>)}</tr>)}</tbody></table></div></div>)}<div class="seo-note"><strong>Il volo modifica il percorso.</strong><p>Gli esempi presuppongono arrivo a Tokyo e partenza dal Kansai. Se rientri da Tokyo, servono tempo e budget per tornarci: riorganizziamo le ultime tappe.</p></div><p>Vuoi confrontare altre combinazioni? Leggi un <a href={`${base}itinerario-giappone-10-giorni/`}>percorso di 10 giorni più concentrato</a> e una <a href={`${base}itinerario-giappone-14-giorni/`}>variante di 14 giorni con Kanazawa e Takayama</a>. Le Alpi giapponesi richiedono priorità diverse: non vanno aggiunte a tutte le tappe del percorso classico.</p></div></section>
<section class="section alt"><div class="container"><div class="section-head"><p class="kicker">Preparare le scelte</p><h2>Prima di richiedere una proposta</h2></div><div class="grid-3"><article class="card"><h3>Periodo</h3><p>Non scegliere soltanto per una fotografia di ciliegi o aceri: stagione, caldo, pioggia e affluenza cambiano l’esperienza.</p><a href={`${base}quando-andare-giappone/`}>Quando partire →</a></article><article class="card"><h3>Budget e spostamenti</h3><p>Considera voli, hotel, treni, pasti ed esperienze insieme. Un pass ferroviario si valuta sul percorso effettivo.</p><a href={`${base}giappone-pratico/`}>Leggi i consigli pratici →</a></article><article class="card"><h3>Il tuo ritmo</h3><p>Indica chi viaggia, quanta strada vuoi fare a piedi e quali tappe ti interessano. Una notte in più nella stessa città può valere più di un’altra destinazione.</p><a href="#proposta">Prepara la richiesta →</a></article></div></div></section>
<section class="section" id="proposta"><div class="container"><div class="cta"><div><p class="kicker">Davide Fois · Travel Consultant</p><h2>Trasformiamo le idee nel tuo itinerario.</h2><p>Scrivimi mese di partenza, giorni disponibili, numero ed età dei partecipanti, budget indicativo e tre esperienze che ti hanno colpito. Ti aiuterò a scegliere tappe, alloggi e servizi coerenti con il viaggio.</p></div><a class="button button-primary" href={`${base}preventivo/?destinazione=Giappone&tipo=Tour%20culturale`}>Richiedi una proposta su misura</a></div></div></section>
</BaseLayout>
<style>
.first-hero{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding:60px 0}.first-hero h1{font-size:clamp(2.2rem,5vw,4rem)}.route-block{margin:40px 0}.route-block h3{font-size:1.8rem}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:16px}table{width:100%;border-collapse:collapse;font-size:1rem}th,td{text-align:left;padding:18px;vertical-align:top;border-bottom:1px solid var(--line)}th{background:var(--navy);color:white}td:first-child{white-space:nowrap;font-weight:800}td:nth-child(2){min-width:150px}td:last-child{min-width:230px}tr:last-child td{border-bottom:0}.credits{font-size:.9rem;color:var(--muted)}section[id]{scroll-margin-top:110px}@media(max-width:900px){.first-hero{grid-template-columns:1fr;gap:24px}}@media(max-width:560px){.first-hero{padding:40px 0}th,td{padding:12px}}
</style>
