---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { continents } from '../../data/continents';
export function getStaticPaths() {
  return continents.map(continent => ({ params: { continente: continent.slug }, props: { continent } }));
}
const { continent } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`Viaggi in ${continent.name} su misura | Davide Fois`} description={continent.description}>
  <section class="page"><div class="container">
    <nav class="breadcrumbs" aria-label="Percorso"><a href={base}>Home</a><span aria-hidden="true">/</span><a href={`${base}destinazioni/`}>Destinazioni</a><span aria-hidden="true">/</span><span>{continent.name}</span></nav>
    <div class="section-head"><p class="kicker">{continent.subtitle}</p><h1>Il tuo viaggio in {continent.name}.</h1><p>{continent.description}</p></div>
    <nav class="continent-tabs" aria-label="Scegli un continente">{continents.map(item => <a href={`${base}destinazioni/${item.slug}/`} aria-current={item.slug === continent.slug ? 'page' : undefined}>{item.name}</a>)}</nav>
    <div class="destination-search"><label for="destination-search">Cerca una destinazione in {continent.name}</label><input id="destination-search" type="search" placeholder="Scrivi il nome di un Paese" autocomplete="off" /><p id="destination-count" role="status" aria-live="polite">{continent.countries.length} destinazioni</p></div>
    <div class="grid-3" id="country-grid">{continent.countries.map(country => (
      <article class="card country-card" data-country={country}>
        <p class="kicker">{continent.name}</p><h2>{country}</h2>
        {country === 'Giappone' ? <><p>Guide alle città, itinerari e strumenti pratici per preparare il viaggio.</p><a class="text-link" href={`${base}giappone/`}>Guide e itinerari →</a></> : <p>Una proposta da costruire insieme, in base a periodo, durata, budget e interessi.</p>}
        {country === 'Lituania' && <a class="text-link" href={`${base}blog/weekend-a-vilnius/`}>Leggi la guida a Vilnius →</a>}
        <a class="button button-dark" href={`${base}preventivo/?destinazione=${encodeURIComponent(country)}`}>Richiedi una proposta</a>
      </article>
    ))}</div>
    <p id="no-destinations" hidden>Nessuna corrispondenza nell’elenco. Puoi comunque richiedere una proposta per la tua meta.</p>
    <div class="world-help"><div><h2>La tua meta non è nell’elenco?</h2><p>Raccontamela: valuteremo insieme come organizzare il viaggio.</p></div><a class="button button-dark" href={`${base}preventivo/?destinazione=${encodeURIComponent('Altra meta in ' + continent.name)}`}>Parliamo del tuo viaggio</a></div>
  </div></section>
</BaseLayout>
<script>
  const input = document.querySelector<HTMLInputElement>('#destination-search');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.country-card'));
  const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('it');
  input?.addEventListener('input', () => {
    const query = normalize(input.value.trim());
    let count = 0;
    cards.forEach(card => { card.hidden = !normalize(card.dataset.country ?? '').includes(query); if (!card.hidden) count++; });
    const status = document.querySelector('#destination-count');
    if (status) status.textContent = `${count} ${count === 1 ? 'destinazione' : 'destinazioni'}`;
    const empty = document.querySelector<HTMLElement>('#no-destinations');
    if (empty) empty.hidden = count > 0;
  });
</script>
