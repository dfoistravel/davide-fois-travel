---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndonesiaPhoto from '../components/IndonesiaPhoto.astro';
import type { IndonesiaPhotoKey } from '../data/indonesiaPhotos';
const base = import.meta.env.BASE_URL;
const quote = `${base}preventivo/?destinazione=Indonesia`;
const regions: { name: string; photo: IndonesiaPhotoKey; tag: string; description: string; detail: string }[] = [
 {name:'Giava',photo:'giava',tag:'Templi e paesaggi vulcanici',description:'Yogyakarta, Borobudur e Prambanan per un viaggio tra storia, arte e cultura. Il Bromo può aggiungere una tappa nei paesaggi vulcanici della parte orientale dell’isola.',detail:'Per chi cerca cultura e natura, con tappe da scegliere in base alle distanze.'},
 {name:'Bali',photo:'bali',tag:'Tradizioni, risaie e mare',description:'Ubud, templi e risaie nell’interno, poi una base sulla costa. Scegliamo le località secondo il tuo ritmo: visite culturali, passeggiate, benessere o giornate al mare.',detail:'Per chi vuole combinare esperienze diverse senza cambiare alloggio ogni giorno.'},
 {name:'Lombok e isole Gili',photo:'lombok',tag:'Spiagge e natura',description:'Lombok tra colline, villaggi e spiagge; le Gili per un soggiorno sulle piccole isole. Le escursioni in montagna e le giornate sul mare richiedono programmi differenti.',detail:'Per chi desidera relax o attività nella natura, scegliendo una base adatta.'},
 {name:'Flores e Komodo',photo:'komodo',tag:'Paesaggi e arcipelaghi',description:'Flores per un percorso tra paesaggi e comunità locali. Labuan Bajo è la porta verso il Parco nazionale di Komodo, con escursioni in barca e panorami come quelli di Padar.',detail:'Per chi ama esplorare: definiamo tempo a terra, navigazione e spostamenti.'},
 {name:'Sumatra',photo:'sumatra',tag:'Foreste e grandi laghi',description:'Il nord dell’isola permette di unire Bukit Lawang, le foreste e il lago Toba. Un percorso da organizzare con guide locali, lasciando tempo ai trasferimenti via terra.',detail:'Per chi cerca natura e cultura locale. Gli avvistamenti di fauna non sono garantiti.'},
 {name:'Sulawesi',photo:'sulawesi',tag:'Culture locali e mare',description:'Le tradizioni Toraja nell’interno e le esperienze marine nel nord offrono due prospettive dell’isola. Scegliamo una zona oppure un percorso più lungo con collegamenti dedicati.',detail:'Per chi desidera un itinerario culturale o marino con tempi ben studiati.'}
];
const itineraries = [
 {title:'Giava e Bali',days:'14 giorni · 13 notti',route:'Yogyakarta → Ubud → costa di Bali',text:'Quattro notti a Yogyakarta per città e templi, cinque a Ubud e quattro su una base al mare. Il Bromo è una possibile estensione: richiede più tempo e una diversa organizzazione delle tappe.',type:'Tour culturale'},
 {title:'Bali, Lombok o Gili',days:'14 giorni · 13 notti',route:'Ubud → costa di Bali → Lombok oppure Gili',text:'Cinque notti a Ubud, tre sulla costa di Bali e cinque a Lombok oppure su una delle Gili. Scegliamo una sola estensione, confrontando collegamenti aerei e marittimi con le tue date.',type:'Mare e relax'},
 {title:'Flores e Komodo',days:'12 giorni · 11 notti',route:'Flores → Labuan Bajo → escursioni nel parco',text:'Sette notti per un percorso a Flores e quattro a Labuan Bajo, con una o più escursioni in barca. Distribuzione delle tappe, aeroporto di arrivo e visite si definiscono insieme, secondo collegamenti e ritmo desiderato.',type:'Natura e avventura'}
];
const faq = [
 {question:'Da dove iniziare un primo viaggio in Indonesia?',answer:'Partiamo dalle esperienze che cerchi. Giava per templi e cultura, Bali per combinare interno e costa, Lombok e Gili per un soggiorno sulle isole. Flores, Sumatra, Sulawesi e Raja Ampat possono diventare il centro di un viaggio dedicato.'},
 {question:'Quante isole inserire in due settimane?',answer:'In genere è più piacevole concentrarsi su una o due aree principali. Ogni cambio di isola può richiedere voli, trasferimenti e parte di una giornata: valutiamo i tempi reali prima di aggiungere tappe.'},
 {question:'È possibile organizzare solo Sumatra, Sulawesi o Raja Ampat?',answer:'Sì, possiamo costruire una proposta dedicata a una di queste aree. Durata, stagione, sistemazioni e collegamenti vengono valutati separatamente, senza dover passare da Bali.'},
 {question:'Quanto costa un viaggio in Indonesia?',answer:'Il costo dipende da voli, regioni, stagione, hotel e attività. Le mete più remote possono richiedere più trasferimenti: definire le priorità aiuta a costruire un preventivo coerente con il budget.'}
];
const schema = {'@context':'https://schema.org','@type':'TouristDestination',name:'Indonesia',description:'Viaggi personalizzati tra Giava, Bali, Lombok, Flores, Sumatra, Sulawesi e Raja Ampat.'};
---
<BaseLayout title="Viaggio in Indonesia | Isole e itinerari su misura con Davide Fois" description="Scopri Giava, Bali, Lombok, Flores e Komodo, Sumatra, Sulawesi e Raja Ampat. Idee di itinerario e consulenza per un viaggio in Indonesia su misura." image={`${base}images/indonesia/komodo-1280.webp`} schema={schema}>
 <section class="hero"><div class="container indonesia-hero-grid"><div><p class="kicker"><a href={`${base}destinazioni/asia/`}>Asia</a> · Indonesia</p><h1>La tua Indonesia, un’isola alla volta.</h1><p class="lead">Templi a Giava, risaie a Bali, foreste a Sumatra e arcipelaghi da esplorare. Scegliamo le regioni che ti incuriosiscono e costruiamo un viaggio con il tempo giusto per viverle.</p><div class="actions"><a class="button button-primary" href={quote}>Richiedi un preventivo gratuito</a><a class="button button-ghost" href="#isole">Esplora le destinazioni</a></div></div><div><IndonesiaPhoto photo="komodo" variant="hero" /><p class="hero-caption">Padar · Parco nazionale di Komodo</p></div></div></section>
 <section class="section"><div class="container"><nav class="experience-links" aria-label="Esplora l’Indonesia"><a href="#isole">Isole e regioni →</a><a href="#itinerari">Idee di itinerario →</a><a href="#informazioni">Quando partire e consigli →</a></nav></div></section>
 <section class="section alt" id="isole"><div class="container"><div class="section-head"><p class="kicker">Un arcipelago da conoscere</p><h2>Quale Indonesia vorresti vivere?</h2><p>Culture, paesaggi e distanze cambiano da un’isola all’altra. Queste sono alcune aree da cui partire per progettare il tuo viaggio.</p></div><div class="grid-3">{regions.map(region => <article class="card indonesia-region"><IndonesiaPhoto photo={region.photo} /><p class="kicker">{region.tag}</p><h3>{region.name}</h3><p>{region.description}</p><p class="region-detail">{region.detail}</p><a class="text-link" href={`${base}preventivo/?destinazione=${encodeURIComponent('Indonesia - ' + region.name)}`}>Parliamo di {region.name} →</a></article>)}</div>
 <article class="card indonesia-spotlight"><IndonesiaPhoto photo="raja-ampat" variant="wide" /><div><p class="kicker">Papua sud-occidentale · Indonesia orientale</p><h3>Raja Ampat</h3><p>Isole calcaree, lagune e biodiversità marina per un viaggio centrato sul mare. Snorkeling, immersioni e visite ai villaggi possono essere il cuore del soggiorno.</p><p>Una meta da progettare con tempo dedicato: collegamenti via Sorong, trasferimenti in barca, stagione e sistemazione guidano la scelta del percorso.</p><a class="text-link" href={`${base}preventivo/?destinazione=${encodeURIComponent('Indonesia - Raja Ampat')}`}>Progettiamo il tuo viaggio a Raja Ampat →</a></div></article>
 </div></section>
 <section class="section"><div class="container"><div class="section-head"><p class="kicker">Il tuo modo di viaggiare</p><h2>Cultura, natura o mare?</h2></div><div class="grid-3"><article class="card"><h3>Cultura e vita locale</h3><p>Templi, mercati, cucina e tradizioni: scegliamo visite e guide che aiutino a conoscere i luoghi, lasciando spazio anche alle giornate libere.</p></article><article class="card"><h3>Natura ed esplorazione</h3><p>Foreste, laghi e paesaggi vulcanici. Definiamo difficoltà delle escursioni, tempi di percorrenza e tappe adatte alla tua preparazione.</p></article><article class="card"><h3>Mare e isole</h3><p>Spiagge, snorkeling o immersioni: la scelta della località dipende dalla stagione, dalle attività e dal tipo di soggiorno che immagini.</p></article></div></div></section>
 <section class="section alt" id="itinerari"><div class="container"><div class="section-head"><p class="kicker">Tre idee da personalizzare</p><h2>Un percorso con il ritmo giusto.</h2><p>Schemi indicativi del soggiorno in Indonesia. I voli internazionali possono aggiungere giorni; trasferimenti, disponibilità e attività si verificano nella proposta.</p></div><div class="grid-3">{itineraries.map(item => <article class="card itinerary-card"><p class="kicker">{item.days}</p><h3>{item.title}</h3><p class="itinerary-route">{item.route}</p><p>{item.text}</p><a class="text-link" href={`${quote}&tipo=${encodeURIComponent(item.type)}`}>Personalizza questo viaggio →</a></article>)}</div><div class="world-help"><div><h3>Preferisci Sumatra, Sulawesi o Raja Ampat?</h3><p>Possiamo dedicare il viaggio a una sola regione e costruire un percorso intorno ai tuoi interessi.</p></div><a class="button button-dark" href={quote}>Raccontami la tua idea</a></div></div></section>
 <section class="section" id="informazioni"><div class="container"><div class="section-head"><p class="kicker">Prima di scegliere</p><h2>Stagioni e distanze fanno parte del viaggio.</h2></div><div class="grid-3"><article class="card"><h3>Quando partire</h3><p>Per Giava e Bali, aprile–ottobre è generalmente il periodo più asciutto; novembre–marzo è più piovoso. È un orientamento, non una previsione.</p><p>Per le altre regioni verifichiamo il clima locale e le condizioni del mare: il periodo favorevole di Bali non vale automaticamente per tutto l’arcipelago.</p></article><article class="card"><h3>Come spostarsi</h3><p>Voli interni, traghetti e trasferimenti via terra vanno scelti in base alle tappe. Gli orari e il meteo possono incidere sui collegamenti marittimi.</p><p>Prevediamo margine prima del volo internazionale e confrontiamo il tempo degli spostamenti con i giorni disponibili.</p></article><article class="card"><h3>Preparare la partenza</h3><p>Definiamo aeroporto di partenza, budget, sistemazioni e attività. Per trekking, immersioni ed escursioni in barca scegliamo servizi adatti alle esigenze del viaggio.</p><p>Documenti, requisiti d’ingresso e aggiornamenti sono nella <a href="https://www.viaggiaresicuri.it/find-country/country/IDN" target="_blank" rel="noopener noreferrer">scheda Indonesia di Viaggiare Sicuri</a>, da consultare prima di prenotare e partire.</p></article></div><p class="sources-note">Per conoscere le regioni: <a href="https://www.indonesia.travel/in/en/destination" target="_blank" rel="noopener noreferrer">Wonderful Indonesia</a>. Indicazioni climatiche: <a href="https://www.indonesia.travel/nl/en/general-information/weather-climate-seasons" target="_blank" rel="noopener noreferrer">ente del turismo indonesiano</a>.</p></div></section>
 <section class="section alt"><div class="container"><div class="section-head"><p class="kicker">Domande frequenti</p><h2>Le risposte per iniziare.</h2></div><div class="faq-grid">{faq.map(item => <details class="faq-item"><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>
 <section class="section"><div class="container cta executive-cta"><div><p class="kicker">Il tuo viaggio inizia qui</p><h2>Raccontami l’Indonesia che immagini.</h2><p>Quando vuoi partire, quanto tempo hai e cosa desideri vivere? Da queste risposte nasce una proposta costruita sulle tue esigenze.</p></div><a class="button button-primary" href={quote}>Richiedi il preventivo gratuito</a></div></section>
 <div class="container indonesia-photo-note"><p>Fotografie di repertorio da Wikimedia Commons, con autore e licenza indicati accanto a ogni immagine. Ridimensionamento, conversione WebP e ritaglio per il sito; le immagini con licenza CC BY-SA 4.0 mantengono la stessa licenza.</p></div>
</BaseLayout>
<style>
.indonesia-hero-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:48px;align-items:center;padding:70px 0}.hero-caption{color:#e5eaf0;font-size:.85rem;margin:12px 0 0}.hero .kicker a{color:inherit}.indonesia-region,.itinerary-card{display:flex;flex-direction:column;min-width:0}.indonesia-region .text-link,.itinerary-card .text-link{margin-top:auto;padding-top:18px}.region-detail{font-size:.9rem;color:var(--muted)}.itinerary-route{font-weight:700;font-size:.92rem}.indonesia-spotlight{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:36px;align-items:center;margin-top:30px}.indonesia-spotlight h3{font-size:2.1rem}.sources-note,.indonesia-photo-note{font-size:.85rem;line-height:1.6;color:var(--muted);overflow-wrap:anywhere}.sources-note{margin-top:28px}.indonesia-photo-note{padding-bottom:30px}
@media(max-width:900px){.indonesia-hero-grid,.indonesia-spotlight{grid-template-columns:1fr;gap:30px}.indonesia-hero-grid{padding:48px 0}}
</style>
