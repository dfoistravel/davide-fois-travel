@media(max-width:900px){.bangkok-hero-grid,.bangkok-excursion{grid-template-columns:1fr;gap:30px}.bangkok-hero-grid{padding:48px 0}.bangkok-photo-grid{gap:16px}}
@media(max-width:700px){.bangkok-place-grid,.bangkok-area-grid,.bangkok-photo-grid{grid-template-columns:1fr}.bangkok-area-grid .card:last-child{grid-column:auto}.guide-callout{padding:24px}.bangkok-day-list{padding-left:20px}.bangkok-day-list li{padding-left:4px}}
