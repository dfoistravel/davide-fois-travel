---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JapanPhoto from '../../../components/JapanPhoto.astro';
import { japanRegions } from '../../../data/japanRegions';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Le regioni del Giappone: città, cultura e natura | Davide Fois" description="Esplora le 10 aree turistiche del Giappone, da Hokkaido a Okinawa. Scopri città, piccoli centri, natura e guide per scegliere il viaggio.">
<section class="hero"><div class="container region-hero"><div><p class="kicker"><a href={`${base}giappone/`}>Giappone</a> · Esplora il territorio</p><h1>Il Giappone, regione dopo regione.</h1><p class="lead">Dalle città ai piccoli centri, dai santuari ai paesaggi naturali: scopri quale parte del Giappone vorresti conoscere. Ogni area ha un carattere diverso e merita un percorso costruito con il tempo giusto.</p><div class="actions"><a class="button button-primary" href="#regioni">Scegli una regione</a><a class="button button-ghost" href={`${base}primo-viaggio-giappone/`}>È il tuo primo viaggio?</a></div></div><JapanPhoto photo="giardino" variant="hero" eager caption="Un giardino giapponese · fotografia di Davide Fois" /></div></section>
<section class="section" id="regioni"><div class="container"><div class="section-head"><p class="kicker">Dal nord alle isole del sud</p><h2>Dieci aree per orientarti</h2><p>Seguiamo la suddivisione turistica di JNTO, con tutte le 47 prefetture. Le panoramiche regionali ti aiutano a scegliere; le guide di località disponibili approfondiscono visite e organizzazione.</p></div><div class="region-search"><label for="region-search">Cerca una regione, una prefettura o una località</label><input id="region-search" type="search" placeholder="Per esempio: Kyushu, Nagano, Tokyo…" /><p id="region-count" role="status" aria-live="polite">10 aree disponibili</p></div><div class="region-grid">{japanRegions.map((r,i) => <article class="card region-card" data-region data-search={`${r.name} ${r.prefectures.join(' ')} ${r.cities.join(' ')} ${r.nature.join(' ')}`}><div class="region-top"><span class="region-number">{String(i+1).padStart(2,'0')}</span><p class="kicker">{r.prefectures.length} {r.prefectures.length === 1 ? 'prefettura' : 'prefetture'}</p></div><h3>{r.name}</h3><p class="region-subtitle">{r.title}</p><p>{r.intro}</p><p class="region-highlight"><strong>Tra le tappe:</strong> {r.cities.slice(0,3).join(', ')}; {r.nature.slice(0,2).join(', ')}.</p><a class="button button-dark" href={`${base}giappone/regioni/${r.slug}/`}>Esplora {r.name}</a></article>)}</div><p id="region-empty" hidden>Nessun risultato. Prova con un’altra regione o prefettura.</p></div></section>
<section class="section alt"><div class="container"><div class="section-head"><p class="kicker">Scegli anche per interesse</p><h2>Che cosa cerchi nel viaggio?</h2></div><div class="grid-3"><article class="card"><h3>Città e cultura</h3><p>Quartieri, templi, castelli e piccoli centri storici. Parti dalle regioni e scegli le tappe che desideri approfondire.</p><a href={`${base}giappone/regioni/kanto/`}>Tokyo e il Kanto →</a></article><article class="card"><h3>Natura e cammini</h3><p>Montagne, boschi, valli e paesaggi rurali richiedono scelte di stagione e trasporti. Indica esperienza e ritmo desiderato.</p><a href={`${base}giappone/regioni/hokkaido/`}>Scopri la panoramica di Hokkaido →</a></article><article class="card"><h3>Terme e soggiorni lenti</h3><p>Lascia spazio alle notti, ai pasti e alle passeggiate. Una località termale può diventare una parte centrale del viaggio.</p><a href={`${base}kusatsu-onsen/`}>Leggi la guida di Kusatsu →</a></article></div><p class="region-note">Fonti territoriali: <a href="https://www.japan.travel/en/destinations/">JNTO · Destinazioni del Giappone</a>. Selezione delle tappe e consigli di viaggio: Davide Fois.</p></div></section>
</BaseLayout>
<script>
const field = document.querySelector<HTMLInputElement>('#region-search');
const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-region]'));
const normalize = (s:string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
field?.addEventListener('input', () => {
 const words = normalize(field.value.trim()).split(/\s+/).filter(Boolean);let count=0;
 cards.forEach(card => {const matches=words.every(w => normalize(card.dataset.search ?? '').includes(w));card.hidden=!matches;if(matches)count++;});
 const status=document.querySelector('#region-count');if(status)status.textContent=`${count} ${count===1?'area trovata':'aree trovate'}`;
 const empty=document.querySelector<HTMLElement>('#region-empty');if(empty)empty.hidden=count!==0;
});
</script>
<style>
.region-hero{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center;padding:60px 0}.region-hero h1{font-size:clamp(2.4rem,5vw,4rem)}.region-search{margin:0 0 30px;max-width:620px}.region-search input{width:100%;margin:10px 0}.region-search p{font-size:.9rem;color:var(--muted)}.region-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px}.region-card{display:flex;flex-direction:column;border-top:4px solid var(--gold)}.region-card[hidden]{display:none}.region-top{display:flex;gap:18px;align-items:center;justify-content:space-between}.region-number{font-size:2rem;font-weight:800;color:var(--gold)}.region-card h3{font-size:2rem;margin-top:12px}.region-subtitle{font-weight:700}.region-highlight{color:var(--muted)}.region-card .button{align-self:flex-start;margin-top:auto}.region-note{font-size:.9rem;margin-top:30px}section[id]{scroll-margin-top:110px}@media(max-width:900px){.region-hero{grid-template-columns:1fr}}@media(max-width:650px){.region-grid{grid-template-columns:1fr}.region-hero{padding:40px 0}}
</style>
