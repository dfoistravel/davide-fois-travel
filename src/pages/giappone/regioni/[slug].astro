---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JapanPhoto from '../../../components/JapanPhoto.astro';
import { japanRegions } from '../../../data/japanRegions';
import type { JapanPhotoKey } from '../../../data/japanPhotos';
export function getStaticPaths(){return japanRegions.map(region => ({params:{slug:region.slug},props:{region}}));}
const { region:r } = Astro.props;
const base=import.meta.env.BASE_URL;
const photo = r.slug==='kanto' ? 'sensoji' : r.slug==='kansai' ? 'kinkakuji' : r.slug==='chugoku' ? 'hiroshima' : r.slug==='tokai' ? 'fuji' : null;
---
<BaseLayout title={`${r.name}: città, cultura e natura | Davide Fois Travel`} description={r.intro}>
<section class="hero"><div class:list={['container','area-hero',{'area-hero-photo':photo}]}><div><p class="kicker"><a href={`${base}giappone/regioni/`}>Le regioni del Giappone</a> · {r.name}</p><h1>{r.name}: {r.title.toLowerCase()}.</h1><p class="lead">{r.intro}</p><div class="actions"><a class="button button-primary" href="#luoghi">Conosci l’area</a>{r.guides.length>0 && <a class="button button-ghost" href="#guide">Leggi gli approfondimenti</a>}</div></div>{photo && <JapanPhoto photo={photo} variant="hero" eager caption={`${r.name} · Fotografia di Davide Fois`} />}</div></section>
<section class="section" id="luoghi"><div class="container"><div class="section-head"><p class="kicker">Il territorio</p><h2>Quali luoghi ti incuriosiscono?</h2><p>Una selezione per orientarti. Le tappe non sono un unico itinerario: distanze e interessi determinano quali combinare.</p></div><div class="grid-3"><article class="card"><h3>Città e centri da conoscere</h3><ul>{r.cities.map(c=><li>{c}</li>)}</ul></article><article class="card"><h3>Natura e soggiorni fuori città</h3><ul>{r.nature.map(c=><li>{c}</li>)}</ul></article><article class="card"><h3>Cultura e identità</h3><p>{r.culture}</p></article></div><div class="area-prefectures"><h3>Le prefetture di quest’area</h3><div class="area-tags">{r.prefectures.map(p=><span>{p}</span>)}</div></div></div></section>
{r.guides.length>0 && <section class="section alt" id="guide"><div class="container"><div class="section-head"><p class="kicker">Approfondimenti disponibili</p><h2>Fotografie, luoghi e consigli per scegliere</h2><p>Apri le guide di località per capire cosa vedere, quanto tempo dedicare e come organizzare la visita.</p></div><div class="grid-3">{r.guides.map(g=><article class="card area-guide"><JapanPhoto photo={g.photo as JapanPhotoKey}/><h3>{g.name}</h3><a href={`${base}${g.slug}/`}>Leggi la guida →</a></article>)}</div></div></section>}
{r.slug==='kanto' && <section class="section"><div class="container"><div class="section-head"><p class="kicker">Costruire il percorso</p><h2>Tre modi di esplorare il Kanto</h2><p>Indicazioni di Davide da adattare ai giorni pieni disponibili, agli interessi e agli orari dei collegamenti.</p></div><div class="grid-3"><article class="card"><h3>5–6 giorni · Tokyo e una scelta fuori città</h3><p>Tre o quattro giorni pieni a Tokyo e un’escursione a Kamakura, Yokohama oppure Takao. Arrivo e partenza possono richiedere giorni aggiuntivi.</p></article><article class="card"><h3>7–9 giorni · Città e cultura</h3><p>Tokyo, una selezione tra Kamakura e Yokohama, poi Nikko con una notte se desideri anche la zona montana. Non aggiungere tutte le altre escursioni.</p></article><article class="card"><h3>10–14 giorni · Un viaggio regionale</h3><p>Tokyo, tappe culturali e una pausa termale a Hakone oppure Kusatsu. Narita/Sawara o Mito possono entrare scegliendo cosa ridurre e valutando il percorso.</p></article></div><div class="seo-note"><strong>Fuji e Hakone: due aree da distinguere.</strong><p>Hakone è in Kanagawa, nel Kanto. Kawaguchiko è in Yamanashi, nel Tokai secondo questa suddivisione turistica. La <a href={`${base}monte-fuji-hakone/`}>guida condivisa</a> aiuta a confrontarle; non sono un’unica escursione.</p></div></div></section>}
<section class="section alt"><div class="container area-two"><div><p class="kicker">Il consiglio di Davide</p><h2>Come scegliere il ritmo</h2><p>{r.planning}</p><p>Per un primo orientamento confronta periodo, giorni disponibili e priorità. Poi scegli le basi e verifica gli spostamenti effettivi.</p><a href={`${base}giappone-pratico/`}>Preparare il viaggio: budget e trasporti →</a></div><aside class="card"><h3>Informazioni territoriali</h3><p>Questa panoramica ti aiuta a scegliere l’area. Apri gli approfondimenti collegati per conoscere le singole località oppure raccontami quali tappe ti interessano per costruire un percorso personalizzato.</p><p><a href={r.source} target="_blank" rel="noopener noreferrer">{r.name} · turismo ufficiale JNTO →</a></p><p class="area-note">Fonte verificata il 9 ottobre 2026. Per accessi, servizi e condizioni stagionali consulta le informazioni ufficiali vicino alla partenza.</p></aside></div></section>
<section class="section"><div class="container"><div class="cta"><div><p class="kicker">Il tuo Giappone</p><h2>Ti riconosci in questa regione?</h2><p>Raccontami quali luoghi ti interessano, periodo e giorni disponibili. Valutiamo insieme un viaggio nella regione oppure un collegamento con altre aree.</p></div><a class="button button-primary" href={`${base}preventivo/?destinazione=Giappone&tipo=Tour%20culturale`}>Richiedi una proposta</a></div><p class="area-back"><a href={`${base}giappone/regioni/`}>← Esplora tutte le regioni</a></p></div></section>
</BaseLayout>
<style>
.area-hero{padding:65px 0}.area-hero-photo{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}.area-hero h1{font-size:clamp(2.3rem,4.5vw,3.7rem);max-width:900px}.area-prefectures{margin-top:36px}.area-tags{display:flex;flex-wrap:wrap;gap:10px}.area-tags span{padding:9px 15px;background:var(--mist);border:1px solid var(--line);border-radius:30px}.area-guide :global(figure){margin-bottom:24px}.area-two{display:grid;grid-template-columns:1.25fr .75fr;gap:32px;align-items:start}.area-note{font-size:.9rem;color:var(--muted)}.area-back{margin-top:30px}li{margin-bottom:12px}section[id]{scroll-margin-top:110px}@media(max-width:900px){.area-hero-photo,.area-two{grid-template-columns:1fr}}@media(max-width:560px){.area-hero{padding:40px 0}}
</style>
