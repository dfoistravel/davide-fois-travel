.breadcrumbs{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:24px;font-size:.9rem}.north-hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:48px;align-items:center;padding:70px 0}.hero .kicker a{color:inherit}.guide-date,.photo-credit{color:#e5eaf0;font-size:.85rem;margin-top:24px}.photo-credit a{color:inherit}.north-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.north-grid .card{min-width:0}.practical{padding-top:14px;border-top:1px solid #e5eaf0}.north-callout{margin-top:30px;padding:28px 32px;border-left:4px solid var(--gold);border-radius:0 18px 18px 0;background:#f4f6f8}.alt .north-callout{background:white}.north-callout h3{margin-top:0}.reading{max-width:900px}.day-list{padding-left:26px}.day-list li{padding:10px 0 18px 12px}.day-list li::marker{color:var(--gold);font-weight:800}.related{margin-top:30px}.sources{padding-bottom:35px;font-size:.88rem;overflow-wrap:anywhere}.sources li{margin:10px 0}
