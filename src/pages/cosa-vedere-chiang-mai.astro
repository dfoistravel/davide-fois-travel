---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuidePhoto from '../components/GuidePhoto.astro';
const base = import.meta.env.BASE_URL;
const quote = `${base}preventivo/?destinazione=${encodeURIComponent('Thailandia - Chiang Mai e nord')}`;
const places = [
 {photo:'city-chiang-mai',name:'La città vecchia e Tha Phae Gate',label:'Per iniziare',text:'Il fossato e le mura aiutano a orientarsi nel centro storico. Parti dalla porta Tha Phae e alterna strade principali e vicoli: la visita acquista senso quando lasci spazio a un cortile, a una pausa e alla vita quotidiana.',tip:'Dedica una prima mezza giornata a questa zona. Raggruppa i templi senza trasformarli in una lista da completare.'},
 {photo:'chedi-luang',name:'Wat Chedi Luang',label:'Dentro le mura',text:'Il grande chedi in mattoni è uno dei luoghi più riconoscibili della città. Qui la visita ruota attorno alle dimensioni della struttura e agli spazi del complesso, con un’atmosfera diversa rispetto ai templi dorati.',tip:'Inseriscilo nella giornata del centro storico e controlla le regole di accesso alle singole aree.'},
 {photo:'phra-singh',name:'Wat Phra Singh',label:'Architettura e cultura Lanna',text:'Un’altra tappa del centro per osservare decorazioni, edifici religiosi e dettagli dell’arte del nord. Con Wat Chedi Luang permette un primo confronto fra complessi diversi, senza dover attraversare tutta la città.',tip:'Scegli pochi templi e visitali con calma. Copri spalle e ginocchia e segui le indicazioni su scarpe e fotografie.'},
 {photo:'doi-suthep',name:'Doi Suthep',label:'Fuori dal centro',text:'Il tempio Wat Phra That Doi Suthep sorge sul rilievo a ovest della città. La pagoda dorata e la scalinata con i naga ne caratterizzano la visita; dalla terrazza si può vedere Chiang Mai, quando la visibilità lo permette.',tip:'Riserva una mezza giornata indicativa, comprensiva degli spostamenti. Chiedi informazioni sulle alternative alla scalinata se hai esigenze di mobilità.'},
 {photo:'mercato-chiang-mai',name:'Mercati e artigianato',label:'La sera',text:'La Sunday Walking Street nella zona di Tha Phae e Ratchadamnoen offre un’occasione per esplorare bancarelle e artigianato. Il giorno della settimana conta: un soggiorno breve può non includere il mercato che avevi immaginato.',tip:'Verifica giorni e calendario prima di fissare le serate; tieni libera un’alternativa se il mercato non si svolge.'},
 {photo:'nimman',name:'Nimman e la cucina del nord',label:'Cambiare atmosfera',text:'Nimmanhaemin è un’area contemporanea da considerare per locali, caffè e negozi. Per la cucina, il khao soi è un punto di partenza; una lezione di cucina può diventare un’attività del viaggio, se ti interessa approfondire ingredienti e preparazioni.',tip:'Scegli fra una passeggiata a Nimman e un’esperienza gastronomica più lunga: non devono stare per forza nella stessa giornata.'}
] as const;
const areas = [
 {name:'Città vecchia',for:'Una prima visita centrata su templi, vicoli e passeggiate.',check:'Controlla la posizione reale dentro le mura, la distanza dalle visite e l’eventuale rumore della strada.'},
 {name:'Tha Phae e zona a est delle mura',for:'Alternare centro storico e attività serali.',check:'L’atmosfera cambia da una via all’altra. Verifica accesso a piedi, rumore e distanza dal mercato che ti interessa.'},
 {name:'Nimman',for:'Caffè, ristoranti e un ambiente più contemporaneo.',check:'Le visite nella città vecchia richiedono spostamenti. Valuta questa base in funzione delle tue priorità.'},
 {name:'Fuori dal centro',for:'Un soggiorno con più spazio o una struttura immersa nel verde.',check:'Metti nel budget i trasferimenti e verifica come raggiungere ristoranti e attività, soprattutto la sera.'}
];
const faq = [
 {q:'Chiang Mai è adatta a una prima visita in Thailandia?',a:'Può completare Bangkok con una diversa atmosfera urbana e con escursioni in montagna. La inserirei se hai abbastanza giorni per visitarla senza comprimere troppo il resto del viaggio.'},
 {q:'Posso visitare Chiang Rai in giornata?',a:'È possibile organizzare un’escursione, ma richiede molto tempo su strada. Se Chiang Rai è una priorità, preferisco valutare una tappa con pernottamento e collegamenti coerenti con il resto del viaggio.'},
 {q:'Tre giorni bastano?',a:'Tre giorni pieni sono una prima base per città vecchia, Doi Suthep e un’attività a scelta. Per includere Doi Inthanon con più calma partirei da quattro giorni; il giorno di arrivo non equivale automaticamente a un giorno di visita.'},
 {q:'Si può abbinare al mare?',a:'Sì. Il programma dipende dalle date, dalla costa scelta e dai collegamenti disponibili. Prima definiamo le tappe e poi confrontiamo i trasferimenti effettivi.'}
];
const schema = {'@context':'https://schema.org','@type':'Article',headline:'Chiang Mai e il nord della Thailandia: cosa vedere e come organizzare il viaggio',author:{'@type':'Person',name:'Davide Fois'},inLanguage:'it-IT',datePublished:'2026-10-09',dateModified:'2026-10-09',image:new URL(`${base}images/thailandia/chiang-mai-1280.webp`,Astro.site).href};
---
<BaseLayout title="Chiang Mai e nord Thailandia | Cosa vedere e quanti giorni" description="Guida a Chiang Mai: templi, quartieri, Doi Suthep, Doi Inthanon e idee per 3–5 giorni. Come valutare Chiang Rai e Pai nel viaggio." image={`${base}images/thailandia/chiang-mai-1280.webp`} schema={schema}>
<section class="hero"><div class="container north-hero"><div><p class="kicker"><a href={`${base}thailandia/`}>Thailandia</a> · Guida al nord</p><h1>Chiang Mai: templi, montagne e tempo per il nord.</h1><p class="lead">Dentro le mura, il viaggio segue vicoli e cortili. Fuori, cambia scala: rilievi, parchi e altre città richiedono giornate dedicate. Ecco come scegliere cosa vedere e costruire un soggiorno senza troppe tappe.</p><div class="actions"><a class="button button-primary" href="#cosa-vedere">Scopri Chiang Mai</a><a class="button button-ghost" href={quote}>Progettiamo il tuo viaggio</a></div><p class="guide-date">Di Davide Fois · aggiornata il 9 ottobre 2026</p></div><GuidePhoto photo="city-chiang-mai" variant="hero" /></div></section>
<section class="section"><div class="container"><nav class="breadcrumbs" aria-label="Percorso"><a href={base}>Home</a><span>/</span><a href={`${base}thailandia/`}>Thailandia</a><span>/</span><span>Chiang Mai e nord</span></nav><nav class="experience-links" aria-label="Indice della guida"><a href="#durata">Quanti giorni →</a><a href="#cosa-vedere">Cosa vedere →</a><a href="#dove-dormire">Dove dormire →</a><a href="#escursioni">Escursioni →</a><a href="#itinerario">Programma →</a><a href="#nord">Chiang Rai e Pai →</a><a href="#periodo">Periodo e consigli →</a></nav></div></section>
<section class="section alt" id="durata"><div class="container"><div class="section-head"><p class="kicker">Prima di scegliere le tappe</p><h2>Quanti giorni fermarsi a Chiang Mai?</h2><p>Per una prima visita partirei da tre giorni pieni. Le durate qui sotto sono suggerimenti editoriali: arrivo, partenza e trasferimenti possono richiedere tempo aggiuntivo.</p></div><div class="grid-3"><article class="card"><h3>3 giorni pieni</h3><p>Città vecchia, Doi Suthep e un’attività a scelta fra cucina, mercati o un’uscita fuori città. Una prima scoperta con Chiang Mai come unica base.</p></article><article class="card"><h3>4 giorni pieni</h3><p>Puoi dedicare una giornata a Doi Inthanon, lasciando più spazio alle visite urbane e alle pause.</p></article><article class="card"><h3>5 giorni pieni</h3><p>Più margine per natura, artigianato e cucina. Puoi mantenere una sola base: avere più giorni non obbliga ad aggiungere altre città.</p></article></div></div></section>
<section class="section" id="cosa-vedere"><div class="container"><div class="section-head"><p class="kicker">Luoghi e atmosfera</p><h2>Da cosa iniziare a Chiang Mai.</h2><p>Alterna complessi religiosi, quartieri e attività. La varietà rende la visita più interessante di una sequenza di soli templi.</p></div><div class="north-grid">{places.map(place => <article class="card"><GuidePhoto photo={place.photo} /><p class="kicker">{place.label}</p><h3>{place.name}</h3><p>{place.text}</p><p class="practical"><strong>Come inserirlo:</strong> {place.tip}</p></article>)}</div></div></section>
<section class="section alt" id="dove-dormire"><div class="container"><div class="section-head"><p class="kicker">Scegliere la base</p><h2>Dove dormire?</h2><p>Per una prima visita centrata sui templi valuterei la città vecchia o le sue immediate vicinanze. È una scelta di organizzazione, da confrontare con la posizione del singolo hotel.</p></div><div class="north-grid">{areas.map(area => <article class="card"><h3>{area.name}</h3><p><strong>Da considerare per:</strong> {area.for}</p><p><strong>Prima di prenotare:</strong> {area.check}</p></article>)}</div></div></section>
<section class="section" id="escursioni"><div class="container"><div class="section-head"><p class="kicker">Una giornata fuori città</p><h2>Montagne e natura: scegli l’esperienza.</h2></div><div class="north-grid"><article class="card"><GuidePhoto photo="doi-inthanon" /><h3>Doi Inthanon</h3><p>La montagna più alta della Thailandia offre paesaggi e ambienti diversi dal centro urbano. Considerala una giornata dedicata, scegliendo poche soste e tenendo conto dei trasferimenti.</p><p>Una visita panoramica e un trekking sono programmi differenti. Per i sentieri verifica apertura stagionale, eventuale guida richiesta, dislivello, fondo e condizioni del giorno; non promettere un percorso prima di questi controlli.</p></article><article class="card"><GuidePhoto photo="mae-kampong" /><h3>Mae Kampong e altre uscite nel verde</h3><p>Mae Kampong è un villaggio di montagna che può entrare in un programma dedicato alla vita locale e al paesaggio. Scegli l’escursione per ciò che vuoi fare, evitando di accostare molte soste lontane solo perché compaiono sulla stessa mappa.</p><p>Con un trekking chiedi durata effettiva a piedi, difficoltà e dimensione del gruppo. Con una visita al villaggio rispetta gli spazi abitati e chiedi il consenso prima di fotografare le persone.</p></article></div><div class="north-callout"><h3>Vuoi un viaggio con camminate?</h3><p>Raccontami che percorsi fai abitualmente e quanto tempo vuoi trascorrere a piedi. Possiamo scegliere escursioni adatte al tuo ritmo e al periodo.</p><a class="text-link" href={quote}>Organizziamo il tuo nord della Thailandia →</a></div></div></section>
<section class="section alt" id="itinerario"><div class="container reading"><div class="section-head"><p class="kicker">Un esempio da adattare</p><h2>Chiang Mai in tre giorni pieni.</h2><p>Un’idea di programma, da riordinare secondo meteo, giorni dei mercati e posizione dell’hotel. Non è un tour con servizi inclusi.</p></div><ol class="day-list"><li><h3>Giorno 1 · Città vecchia</h3><p>Parti da Tha Phae Gate, poi dedica tempo a Wat Chedi Luang e Wat Phra Singh. Lascia una pausa lunga e scegli la sera in base al calendario dei mercati.</p></li><li><h3>Giorno 2 · Doi Suthep e un altro quartiere</h3><p>Dedica la prima parte della giornata al tempio e agli spostamenti. Al rientro, se hai energia, scegli una passeggiata e una cena a Nimman; altrimenti tieni libera la seconda parte.</p></li><li><h3>Giorno 3 · Un’attività che ti somiglia</h3><p>Scegli una lezione di cucina oppure un’uscita fuori città, con durata e trasferimenti verificati. Evita di concentrare nello stesso giorno attività che richiedono ciascuna molte ore.</p></li></ol><div class="north-callout"><h3>Con uno o due giorni in più</h3><p>Aggiungi una giornata a Doi Inthanon. Un eventuale quinto giorno può restare per musei, artigianato o un’attività rimasta fuori: non serve riempire ogni ora.</p></div></div></section>
<section class="section" id="nord"><div class="container"><div class="section-head"><p class="kicker">Il nord è più di una città</p><h2>Chiang Rai e Pai: quando aggiungerle.</h2><p>Chiang Mai è una base utile per iniziare, ma non sostituisce tutto il nord. Le altre tappe vanno scelte per interesse e tempo disponibile.</p></div><div class="north-grid"><article class="card"><GuidePhoto photo="chiang-rai" /><h3>Chiang Rai · arte e templi</h3><p>Wat Rong Khun, il Tempio Bianco, e Wat Rong Suea Ten, il Tempio Blu, offrono architetture molto diverse da quelle del centro di Chiang Mai. Baan Dam aggiunge una prospettiva legata all’arte.</p><p>Se questa zona è una priorità, valuterei due notti come punto di partenza per distribuire visite e trasferimenti. Un’escursione in giornata da Chiang Mai richiede molte ore su strada: confronta il programma reale prima di sceglierla.</p></article><article class="card"><GuidePhoto photo="pai" /><h3>Pai e Mae Hong Son · un viaggio più lento</h3><p>Questa parte del nord può interessare chi cerca paesaggi montani e un soggiorno con un’altra base. Pai è una tappa distinta, non una visita da aggiungere automaticamente al programma urbano di Chiang Mai.</p><p>Le strade di montagna e le curve incidono sul ritmo. Per una prima idea valuterei almeno due notti a Pai; un percorso che includa anche Mae Hong Son richiede una pianificazione separata.</p></article></div><div class="north-callout"><h3>Una base oppure due?</h3><p>Con pochi giorni sceglierei Chiang Mai. Per un viaggio dedicato al nord, un esempio da valutare è quattro notti a Chiang Mai e due a Chiang Rai, considerando orari di arrivo e partenza. Non aggiungerei anche Pai senza più tempo.</p></div></div></section>
<section class="section alt" id="periodo"><div class="container"><div class="section-head"><p class="kicker">Prima di prenotare</p><h2>Periodo, collegamenti e consigli pratici.</h2></div><div class="grid-3"><article class="card"><h3>Clima e qualità dell’aria</h3><p>Novembre–febbraio è generalmente il periodo più fresco nel nord. In montagna le temperature possono essere diverse da quelle in città; nella stagione piovosa le escursioni richiedono più flessibilità.</p><p>Il nord può attraversare episodi di foschia e inquinamento dell’aria. Per decidere le attività consulta gli aggiornamenti ufficiali di <a href="https://air4thai.pcd.go.th/" target="_blank" rel="noopener noreferrer">Air4Thai</a>. Il mese da solo non garantisce buona visibilità.</p></article><article class="card"><h3>Spostamenti</h3><p>Per arrivare da Bangkok confrontiamo voli e treni sulle date effettive. In città raggruppa le visite a piedi dove possibile e valuta trasporti locali per le altre zone.</p><p>Per escursioni e trasferimenti verso altre città controlla orari, tempi su strada e cosa comprende il servizio. Evita coincidenze serrate con voli successivi.</p></article><article class="card"><h3>Visite e partenza</h3><p>Nei templi copri spalle e ginocchia, segui i cartelli e rispetta le aree di preghiera. Per natura e montagne verifica condizioni e accessi prima di partire.</p><p>Per documenti e aggiornamenti consulta la <a href="https://www.viaggiaresicuri.it/find-country/country/THA" target="_blank" rel="noopener noreferrer">scheda Thailandia di Viaggiare Sicuri</a>.</p></article></div></div></section>
<section class="section"><div class="container"><div class="section-head"><h2>Domande frequenti.</h2></div><div class="faq-grid">{faq.map(item => <details class="faq-item"><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></div></section>
<section class="section alt"><div class="container cta executive-cta"><div><p class="kicker">Dalla guida al tuo viaggio</p><h2>Quale nord vuoi scoprire?</h2><p>Templi, cucina, camminate o più città: raccontami periodo, giorni disponibili e interessi. Costruiamo il programma intorno alle tue priorità.</p></div><a class="button button-primary" href={quote}>Richiedi una proposta per il nord</a></div><div class="container actions related"><a class="text-link" href={`${base}thailandia/`}>Torna alla Thailandia →</a><a class="text-link" href={`${base}cosa-vedere-bangkok/`}>Leggi anche la guida Bangkok →</a><a class="text-link" href={`${base}mare-thailandia-phuket-krabi-koh-samui/`}>Scegli il mare in Thailandia →</a><a class="text-link" href={`${base}blog/`}>Tutte le guide →</a></div></section>
<section class="container sources"><details class="faq-item"><summary>Fonti e crediti</summary><p>Informazioni consultate il 9 ottobre 2026. Durate, confronto fra quartieri e programmi giornalieri sono suggerimenti editoriali di organizzazione, da adattare al singolo viaggio.</p><ul><li><a href="https://www.tourismthailand.org/Destinations/Provinces/chiang%20mai/101">Tourism Authority of Thailand · Chiang Mai</a></li><li><a href="https://www.chiangmai.go.th/english/index.php/welcome/tourism">Provincia di Chiang Mai · templi e luoghi</a></li><li><a href="https://www.tourismthailand.org/Attraction/wat-phra-that-doi-suthep/">Doi Suthep · TAT</a></li><li><a href="https://www.tourismthailand.org/Promotions/78/4-most-visited-tourist-attractions-in-near-chiang-mai-moat-2">Centro storico e Sunday Walking Street · TAT</a></li><li><a href="https://www.tourismthailand.org/Articles/chiang-mai-s-lovely-mountains">Doi Inthanon e Mae Kampong · TAT</a></li><li><a href="https://www.tourismthailand.org/Articles/self-driving-chiang-mai">Luoghi e cucina · TAT</a></li><li><a href="https://www.tourismthailand.org/Destinations/Provinces/Chiang-Rai/102">Chiang Rai · TAT</a></li><li><a href="https://www.tourismthailand.org/Destinations/Provinces/Mae-Hong-Son/106">Pai e Mae Hong Son · TAT</a></li><li><a href="https://thai.tourismthailand.org/Articles/วางแผนเที่ยว-คำถามที่พบบ่อย">Stagioni · TAT</a></li><li><a href="https://air4thai.pcd.go.th/">Air4Thai · qualità dell’aria</a></li></ul><p>Altre foto di repertorio da Wikimedia Commons: soggetto, autore, fonte e licenza accanto a ogni immagine. Ridimensionamenti e ritagli dei file CC BY-SA conservano la rispettiva licenza. Foto di copertina: <a href="https://commons.wikimedia.org/wiki/File:Chiang_mai.jpg">Chiang mai / Martin-Manuel Beaulne</a>, pubblico dominio; ridimensionata e ritagliata per il sito.</p></details></section>
</BaseLayout>
