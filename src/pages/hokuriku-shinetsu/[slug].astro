---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hokurikuPlaces } from '../../data/hokurikuPlaces';
export function getStaticPaths(){return hokurikuPlaces.map(place=>({params:{slug:place.slug},props:{place}}));}
const {place}=Astro.props;
const base=import.meta.env.BASE_URL;
const photoUrl=(filename:string)=>`https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(filename)}?width=1280`;
const kanazawa = place.slug === 'kanazawa';
const attractions = [
  {title:'Kenrokuen',subtitle:'Il grande giardino di Kanazawa',description:'Sentieri, stagni, ponti e alberi modellati con cura raccontano l’arte dei giardini giapponesi. Dedica almeno 60–90 minuti alla visita, meglio al mattino e con un ritmo tranquillo.',photo:'Kanazawa, Kenroku-en gardens.jpg',author:'sergejf',time:'1–1,5 ore'},
  {title:'Higashi Chaya',subtitle:'Le antiche case da tè',description:'Passeggia tra le facciate in legno delle machiya, piccole botteghe e case da tè. Vale la pena esplorare anche le vie secondarie, rispettando la quiete delle abitazioni.',photo:'Kanazawa - Kanazawa769.jpg',author:'lumoplank',time:'1–2 ore'},
  {title:'Castello di Kanazawa',subtitle:'Porte storiche e parco del castello',description:'Il vasto complesso, ricostruito in parte, racconta la storia del dominio Maeda. La porta Ishikawa è uno dei simboli più riconoscibili della città; è molto comodo abbinarlo al Kenrokuen.',photo:'View of Ishikawa Gate of Kanazawa Castle.JPG',author:'そらみみ',time:'1–2 ore'},
  {title:'Mercato Omicho',subtitle:'Sapori del Mare del Giappone',description:'Tra banchi di pesce, prodotti locali e piccoli ristoranti puoi scoprire i sapori regionali. Meglio visitarlo prima del pomeriggio: orari e giorni di chiusura variano tra le attività.',photo:'Omicho Market.JPG',author:'Jpatokal',time:'45–90 minuti'},
  {title:'Nagamachi',subtitle:'L’antico quartiere samurai',description:'Vicoli con muri di terra, canali e residenze storiche evocano la vita dei samurai. Per approfondire considera la visita a una residenza aperta al pubblico, come Nomura-ke.',photo:'Nagamachi samurai district.jpg',author:'sergejf',time:'1–1,5 ore'},
  {title:'Museo d’arte contemporanea del XXI secolo',subtitle:'Kanazawa tra tradizione e design',description:'Un museo dalla struttura circolare, noto per l’architettura e le installazioni. Alcune opere richiedono biglietti o prenotazioni separate: verifica mostre e accessi.',photo:'21st Century Museum of Contemporary Art, Kanazawa001.jpg',author:'Città di Kanazawa',time:'1–2 ore'},
  {title:'Nishi Chaya e quartieri meno frequentati',subtitle:'Una passeggiata più raccolta',description:'Se hai un secondo giorno, scopri anche Nishi Chaya e le stradine attorno al tempio Myoryuji, noto come “tempio ninja”. Le visite al tempio possono richiedere prenotazione.',photo:'Nishi Chaya samurai district under the rain.jpg',author:'sergejf',time:'1–2 ore'}
];
---
<BaseLayout title={`${place.name}: cosa vedere in Hokuriku–Shinetsu | D. Fois Travel`} description={`${place.summary} Luoghi, stagioni e spostamenti.`}>
{kanazawa ? (
<>
<section class="hero"><div class="container kz-hero"><div><p class="kicker"><a href={`${base}hokuriku-shinetsu/`}>Hokuriku–Shinetsu</a> · Ishikawa</p><h1>Kanazawa: cosa vedere, tra giardini e quartieri storici</h1><p class="lead">Un Giappone elegante e raccolto: giardini, cultura samurai, antiche case da tè e sapori del Mare del Giappone. Una guida fotografica per scoprire Kanazawa con calma.</p><div class="actions"><a class="button button-primary" href="#cosa-vedere">Scopri i luoghi da visitare</a><a class="button button-ghost" href="#itinerario">Organizza le giornate</a></div></div><figure><img src={photoUrl('Kanazawa, Kenroku-en gardens.jpg')} alt="Giardino Kenrokuen a Kanazawa" loading="eager" decoding="async"/><figcaption>Kenrokuen · foto sergejf · <a href="https://commons.wikimedia.org/wiki/File:Kanazawa,_Kenroku-en_gardens.jpg" target="_blank" rel="noopener noreferrer">fonte e licenza</a></figcaption></figure></div></section>
<section class="section" id="cosa-vedere"><div class="container"><div class="section-head"><p class="kicker">Guida fotografica della città</p><h2>Sette luoghi da non perdere a Kanazawa</h2><p>Una selezione ragionata: ogni attrazione ha una descrizione concreta e un tempo indicativo. Non sono orari ufficiali, ma suggerimenti utili per organizzare la visita.</p></div><div class="kz-grid">{attractions.map((item,i)=><article class="card kz-card">{item.photo && <figure><img src={photoUrl(item.photo)} alt={`${item.title}, Kanazawa`} loading="lazy" decoding="async"/><figcaption>Foto {item.author} · <a href={`https://commons.wikimedia.org/wiki/File:${encodeURIComponent(item.photo)}`} target="_blank" rel="noopener noreferrer">fonte e licenza</a></figcaption></figure>}<div class="kz-cardbody"><p class="kicker">Tappa {i+1} · {item.time}</p><h3>{item.title}</h3><p class="kz-subtitle">{item.subtitle}</p><p>{item.description}</p></div></article>)}</div></div></section>
<section class="section alt" id="itinerario"><div class="container"><div class="section-head"><p class="kicker">Come organizzare Kanazawa</p><h2>Un itinerario di 2 giorni, senza correre</h2></div><div class="grid-3"><article class="card"><h3>Giorno 1 · Giardini e storia</h3><p>Kenrokuen al mattino, castello e porta Ishikawa, pranzo o merenda nella zona di Omicho. Chiudi con Higashi Chaya, meglio nel tardo pomeriggio.</p></article><article class="card"><h3>Giorno 2 · Quartieri ed esperienze</h3><p>Esplora Nagamachi e una residenza samurai, scegli il museo contemporaneo oppure Nishi Chaya, e lascia tempo alle botteghe artigiane.</p></article><article class="card"><h3>Se hai soltanto un giorno</h3><p>Seleziona Kenrokuen, castello e Higashi Chaya. Aggiungi Omicho se gli orari coincidono; evita di comprimere tutte le attrazioni.</p></article></div></div></section>
<section class="section"><div class="container"><div class="kz-details"><article class="card"><h3>Quanti giorni e quando andare</h3><p><strong>Consigliati:</strong> 2 giorni pieni; 3 se vuoi aggiungere un’escursione.</p><p><strong>Stagioni:</strong> primavera e autunno molto piacevoli; l’inverno può regalare paesaggi suggestivi ma comporta freddo e possibili nevicate.</p></article><article class="card"><h3>Come arrivare e muoversi</h3><p>Kanazawa è servita dall'Hokuriku Shinkansen. Da Kyoto e Osaka il collegamento ferroviario normalmente prevede un cambio a Tsuruga.</p><p>Il centro si esplora con una combinazione di passeggiate e autobus. Alloggiare intorno alla stazione è comodo per gli spostamenti; Korinbo e Katamachi sono utili per ristoranti e passeggiate serali.</p></article><article class="card"><h3>Esperienze e dintorni</h3><p>Prova le specialità del Mare del Giappone, scopri la foglia d’oro e le tradizioni artigiane della zona. Se hai più tempo valuta una giornata a Kaga Onsen oppure altre località della prefettura di Ishikawa.</p></article></div><div class="cta"><div><p class="kicker">Un itinerario personalizzato</p><h2>Vorresti inserire Kanazawa nel tuo viaggio in Giappone?</h2><p>Posso aiutarti a combinarla con Tokyo, Kyoto, Takayama e altre località in base ai giorni disponibili.</p></div><a class="button button-primary" href={`${base}preventivo/?destinazione=Giappone`}>Richiedi una proposta</a></div><p class="kz-footer"><a href={`${base}hokuriku-shinetsu/`}>← Torna a Hokuriku–Shinetsu</a></p></div></section>
</>
) : (
<>
<section class="hero"><div class="container hs-detail"><div><p class="kicker"><a href={`${base}hokuriku-shinetsu/`}>Hokuriku–Shinetsu</a> · {place.area}</p><h1>{place.name}</h1><p class="lead">{place.summary}</p><div class="actions"><a class="button button-primary" href="#luoghi">Cosa vedere</a><a class="button button-ghost" href={`${base}hokuriku-shinetsu/`}>Tutte le guide</a></div></div><figure><img src={photoUrl(place.photo)} alt={place.name} loading="eager" decoding="async"/><figcaption>Foto: {place.credit} · {place.license} · <a href={`https://commons.wikimedia.org/wiki/File:${encodeURIComponent(place.photo)}`} target="_blank" rel="noopener noreferrer">fonte e licenza</a></figcaption></figure></div></section>
<section class="section" id="luoghi"><div class="container"><div class="section-head"><p class="kicker">Punti di interesse</p><h2>Tre esperienze da considerare</h2></div><div class="grid-3">{place.spots.map(spot=><article class="card"><h3>{spot[0]}</h3><p>{spot[1]}</p></article>)}</div></div></section>
<section class="section alt"><div class="container hs-tips"><article class="card"><h3>Quanto tempo dedicare</h3><p>{place.days}</p><h3>Quando andare</h3><p>{place.season}</p></article><article class="card"><h3>Come organizzarsi</h3><p>{place.tip}</p></article></div></section>
<section class="section"><div class="container"><div class="cta"><div><p class="kicker">Itinerario su misura</p><h2>Vuoi visitare {place.name}?</h2><p>Troviamo un percorso adatto a periodo, budget e spostamenti.</p></div><a class="button button-primary" href={`${base}preventivo/?destinazione=Giappone`}>Richiedi una proposta</a></div><p><a href={`${base}hokuriku-shinetsu/`}>← Torna alle guide</a></p></div></section>
</>
)}
</BaseLayout>
<style>
.hs-detail,.kz-hero{display:grid;grid-template-columns:1fr 1fr;gap:34px;padding:62px 0;align-items:center}
.hs-detail figure,.kz-hero figure{margin:0}
.hs-detail img,.kz-hero img{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:18px}
.hs-detail figcaption,.kz-hero figcaption{font-size:.78rem;color:var(--muted);margin-top:8px}
.hs-tips{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.kz-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
.kz-card{padding:0;overflow:hidden}
.kz-card figure{margin:0}
.kz-card figure img{width:100%;aspect-ratio:16/10;object-fit:cover}
.kz-card figcaption{font-size:.73rem;padding:7px 16px;color:var(--muted)}
.kz-cardbody{padding:22px}
.kz-cardbody .kicker{margin-bottom:8px}
.kz-cardbody h3{margin:0 0 7px}
.kz-subtitle{font-weight:700}
.kz-details{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-bottom:32px}
.kz-footer{margin-top:26px}
@media(max-width:800px){.hs-detail,.kz-hero,.hs-tips,.kz-grid,.kz-details{grid-template-columns:1fr}.hs-detail,.kz-hero{padding:40px 0}}
</style>
