---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hokurikuPlaces } from '../../data/hokurikuPlaces';
const base=import.meta.env.BASE_URL;
const photoUrl=(filename:string)=>`https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(filename)}?width=1280`;
---
<BaseLayout title="Hokuriku–Shinetsu: città storiche e Alpi giapponesi | D. Fois Travel" description="Esplora Kanazawa, Matsumoto, Kamikochi, Tateyama, Nagano, Fukui e l'isola di Sado con guide e consigli di viaggio.">
<section class="hero"><div class="container hs-intro"><p class="kicker"><a href={`${base}giappone/regioni/`}>Regioni del Giappone</a> · Hokuriku–Shinetsu</p><h1>Hokuriku–Shinetsu: città d’arte, montagne e Giappone meno conosciuto.</h1><p class="lead">Dai giardini di Kanazawa ai paesaggi delle Alpi giapponesi: sette guide per un viaggio tra tradizione, natura e storia, rispettando le distanze.</p><div class="actions"><a class="button button-primary" href="#destinazioni">Esplora le guide</a><a class="button button-ghost" href="#itinerari">Idee di viaggio</a></div></div></section>
<section class="section" id="destinazioni"><div class="container"><div class="section-head"><p class="kicker">Cinque prefetture · sette guide</p><h2>Quale zona vorresti scoprire?</h2><p>Kanazawa, Matsumoto, Alpi, templi e isole sono esperienze diverse: seleziona poche aree per costruire un percorso realistico.</p></div><div class="hs-grid">{hokurikuPlaces.map(place=><article class="card hs-card"><img src={photoUrl(place.photo)} alt={`Fotografia di ${place.name}`} loading="lazy" decoding="async"/><div class="hs-cardbody"><p class="kicker">{place.area} · {place.days}</p><h3>{place.name}</h3><p>{place.summary}</p><a class="button button-dark" href={`${base}hokuriku-shinetsu/${place.slug}/`}>Scopri la guida →</a></div></article>)}</div></div></section>
<section class="section alt" id="itinerari"><div class="container"><div class="section-head"><p class="kicker">Percorsi consigliati</p><h2>Tre modi di vivere la regione</h2></div><div class="grid-3"><article class="card"><h3>4–5 giorni · Città e giardini</h3><p>Kanazawa e una seconda base nell’area di Toyama, senza aggiungere le Alpi a tutti i costi.</p></article><article class="card"><h3>6–8 giorni · Cultura e montagne</h3><p>Matsumoto, Kamikochi e Nagano, verificando apertura stagionale e autobus.</p></article><article class="card"><h3>8–10 giorni · Percorso occidentale</h3><p>Kanazawa, Fukui e un soggiorno dedicato a Toyama o alle Alpi: scegli un solo grande percorso montano.</p></article></div></div></section>
<section class="section"><div class="container"><div class="cta"><div><p class="kicker">Un percorso personale</p><h2>Il tuo Giappone, oltre le mete classiche</h2><p>Raccontami quanti giorni hai e cosa ti interessa: storia, templi, borghi o paesaggi alpini.</p></div><a class="button button-primary" href={`${base}preventivo/?destinazione=Giappone`}>Richiedi una proposta</a></div><p class="hs-foot">Fotografie: Wikimedia Commons; ogni guida indica autore e collegamento alla scheda di utilizzo. Verifica sempre la stagionalità degli accessi montani.</p></div></section>
</BaseLayout>
<style>.hs-intro{padding:62px 0}.hs-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.hs-card{padding:0;overflow:hidden;display:flex;flex-direction:column}.hs-card img{width:100%;aspect-ratio:16/9;object-fit:cover}.hs-cardbody{padding:24px;flex:1;display:flex;flex-direction:column;gap:12px}.hs-cardbody>.button{align-self:flex-start;margin-top:auto}.hs-foot{margin-top:26px;font-size:.88rem;color:var(--muted)}@media(max-width:700px){.hs-grid{grid-template-columns:1fr}.hs-intro{padding:40px 0}}</style>
