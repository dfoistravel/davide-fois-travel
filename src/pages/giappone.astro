---
import JapanPhoto from '../components/JapanPhoto.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const faq = [
  {
    question: "Qual è il periodo migliore per visitare il Giappone?",
    answer:
      "Dipende dal tipo di esperienza desiderata. La primavera è ideale per i ciliegi, l’autunno per il foliage, l’inverno per neve e onsen, mentre l’estate offre festival e zone montane."
  },
  {
    question: "Quanti giorni servono per un primo viaggio?",
    answer:
      "Per un primo viaggio consiglio 10–14 giorni, scegliendo le tappe in base al ritmo: Tokyo e Kyoto come basi, poi escursioni o estensioni secondo il tempo disponibile."
  },
  {
    question: "È possibile creare un itinerario personalizzato?",
    answer:
      "Sì. Periodo, budget, interessi e ritmo di viaggio vengono utilizzati per costruire una proposta su misura."
  },
  {
    question: "Quanto costa un viaggio in Giappone?",
    answer:
      "Il costo dipende da voli, durata, categoria degli hotel, spostamenti e periodo. Un preventivo personalizzato permette di stimare il budget in modo più preciso."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TouristDestination",
      "name": "Giappone",
      "description":
        "Guida alla progettazione di un viaggio personalizzato in Giappone."
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="Viaggio in Giappone | Itinerari su misura con Davide Fois"
  description="Organizza un viaggio in Giappone con un itinerario personalizzato. Scopri città, stagioni, trasporti e consigli pratici con assistenza dedicata."
  schema={schema}
>
  <section class="hero japan-hero">
    <div class="container hero-grid">
      <div>
        <p class="kicker"><a href={`${base}destinazioni/asia/`}>Asia</a> · Giappone</p>

        <h1>Scopri il Giappone con un viaggio costruito intorno a te.</h1>

        <p class="lead">
          Dalle metropoli ultramoderne ai templi immersi nel silenzio,
          creo itinerari personalizzati in base ai tuoi interessi,
          al periodo dell’anno e al budget disponibile.
        </p>

        <div class="actions">
          <a class="button button-primary" href={`${base}primo-viaggio-giappone/`}>
            Inizia a conoscere il Giappone
          </a>

          <a class="button button-ghost" href="#itinerari">
            Scopri gli itinerari
          </a>
        </div>
      </div>

      <JapanPhoto photo="miyajima" variant="hero" eager caption="Miyajima · fotografia di Davide Fois" />
    </div>
  </section>

  <section class="section"><div class="container"><div class="section-head"><p class="kicker">Il Giappone da Vivere</p><h2>Trova subito quello che ti serve.</h2><p>Dai temi della mia guida: un percorso pratico per scegliere tappe, organizzare i trasporti e preparare la partenza.</p></div><nav class="experience-links" aria-label="Guide per organizzare il Giappone"><a href={`${base}quando-andare-giappone/`}>Quando partire →</a><a href="#itinerari">Scegliere la durata →</a><a href={`${base}giappone-pratico/#budget`}>Budget →</a><a href={`${base}giappone-pratico/#trasporti`}>Trasporti →</a><a href={`${base}giappone-pratico/#connessione`}>Internet e app →</a><a href={`${base}giappone-pratico/#checklist`}>Checklist →</a><a href={`${base}cosa-vedere-tokyo/`}>Tokyo →</a><a href={`${base}cosa-vedere-kyoto/`}>Kyoto →</a><a href={`${base}cosa-vedere-osaka/`}>Osaka →</a><a href={`${base}cosa-vedere-nara/`}>Nara →</a><a href={`${base}monte-fuji-hakone/`}>Fuji e Hakone →</a><a href={`${base}hiroshima-miyajima/`}>Hiroshima e Miyajima →</a><a href={`${base}primo-viaggio-giappone/`}>Il primo viaggio →</a></nav></div></section>
  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Perché scegliere il Giappone</p>
        <h2>Un Paese capace di cambiare volto in ogni stagione.</h2>
      </div>

      <div class="grid-3">
        <article class="card">
          <div class="icon">🏯</div>
          <h3>Cultura e tradizione</h3>
          <p>
            Templi, castelli, giardini e quartieri storici raccontano
            una storia millenaria.
          </p>
        </article>

        <article class="card">
          <div class="icon">🍁</div>
          <h3>Natura e stagioni</h3>
          <p>
            Sakura, foliage, montagne, laghi, onsen e paesaggi diversi
            durante tutto l’anno.
          </p>
        </article>

        <article class="card">
          <div class="icon">🚄</div>
          <h3>Innovazione e comodità</h3>
          <p>
            Trasporti efficienti, città futuristiche e servizi pensati
            per rendere il viaggio più semplice.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Quando andare</p>
        <h2>Ogni stagione offre un’esperienza diversa.</h2>
      </div>
      <div class="seo-note">
  <strong>Non sai quale periodo scegliere?</strong>

  <p>
    Consulta la guida completa con clima, stagioni, ciliegi, foliage,
    affollamento e consigli mese per mese.
  </p>

  <a
    class="button button-dark"
    href={`${base}quando-andare-giappone/`}
  >
    Scopri quando andare in Giappone
  </a>
</div>
      <div class="grid-3">
        <article class="card">
          <h3>Primavera</h3>
          <p>
            Ciliegi in fiore, clima mite e giardini ideali per l’hanami.
          </p>
        </article>

        <article class="card">
          <h3>Estate</h3>
          <p>
            Festival, fuochi d’artificio, montagne e isole del sud.
          </p>
        </article>

        <article class="card">
          <h3>Autunno</h3>
          <p>
            Foliage spettacolare, temperature piacevoli e colori intensi.
          </p>
        </article>

        <article class="card">
          <h3>Inverno</h3>
          <p>
            Neve, onsen, sci e paesaggi alpini in Hokkaido e nelle Alpi.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Destinazioni principali</p>
        <h2>Le tappe più amate per un primo viaggio.</h2>
      </div>

      <div class="grid-3">
        <article class="card japan-destination-card">
          <JapanPhoto photo="shibuya" />
          <h3>Tokyo</h3>
          <p>Quartieri futuristici, templi, musei e vita urbana.</p>
        <a class="text-link" href={`${base}cosa-vedere-tokyo/`}>Scopri di più →</a>
        </article>

        <article class="card japan-destination-card">
          <JapanPhoto photo="kinkakuji" />
          <h3>Kyoto</h3>
          <p>Templi, giardini zen, Gion e tradizioni secolari.</p>
        <a class="text-link" href={`${base}cosa-vedere-kyoto/`}>Scopri di più →</a>
        </article>

        <article class="card japan-destination-card">
          <JapanPhoto photo="osaka-castello" />
          <h3>Osaka</h3>
          <p>Atmosfera vivace, street food e cultura gastronomica.</p>
        <a class="text-link" href={`${base}cosa-vedere-osaka/`}>Scopri di più →</a>
        </article>

        <article class="card japan-destination-card">
          <JapanPhoto photo="nara" />
          <h3>Nara</h3>
          <p>Il Grande Buddha e i celebri cervi del parco.</p>
        <a class="text-link" href={`${base}cosa-vedere-nara/`}>Scopri di più →</a>
        </article>

        <article class="card japan-destination-card">
          <JapanPhoto photo="fuji" />
          <h3>Monte Fuji e Hakone</h3>
          <p>Laghi, funivie, onsen e panorami iconici.</p>
        <a class="text-link" href={`${base}monte-fuji-hakone/`}>Scopri di più →</a>
        </article>

        <article class="card japan-destination-card">
          <JapanPhoto photo="hiroshima" />
          <h3>Hiroshima e Miyajima</h3>
          <p>Storia, memoria e uno dei torii più famosi del Giappone.</p>
        <a class="text-link" href={`${base}hiroshima-miyajima/`}>Scopri di più →</a>
        </article>
      </div>
    </div>
  </section>

  <div class="container"><p class="photo-credit">Foto dei cervi di Nara: <a href="https://commons.wikimedia.org/wiki/File:20190121_Nara_deer-3.jpg">Balon Greyjoy / Wikimedia Commons</a> · <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>.</p></div>
  <section class="section"><div class="container"><div class="section-head"><p class="kicker">Fotografie dai miei viaggi</p><h2>Il Giappone, attraverso il mio sguardo.</h2><p>Templi, giardini e vita quotidiana: alcuni luoghi che ho fotografato durante il mio viaggio.</p></div><div class="japan-photo-grid">
    <JapanPhoto photo="sensoji" caption="Tokyo · il tempio Sensō-ji" />
    <JapanPhoto photo="giardino" caption="La quiete di un giardino giapponese" />
    <JapanPhoto photo="dotonbori" caption="Osaka · il canale di Dotonbori" />
    <JapanPhoto photo="odaiba" caption="Tokyo · la baia da Odaiba" />
  </div></div></section>
  <section class="section" id="itinerari">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Itinerari suggeriti</p>
        <h2>Scegli la durata più adatta al tuo viaggio.</h2>
      </div>

      <div class="grid-3">
        <article class="card">
          <h3>7 giorni</h3>
          <p>Tokyo oppure Kyoto con escursioni vicine. Con due città, gli orari dei voli incidono molto sul tempo di visita.</p><a href={`${base}primo-viaggio-giappone/#percorsi`}>Confronta durata e ritmo →</a>
        </article>

        <article class="card">
          <h3>10 giorni</h3>
          <p>Tokyo e Kyoto, con una giornata per Nara oppure Osaka. Per aggiungere altre tappe, scegli cosa ridurre.</p><a href={`${base}primo-viaggio-giappone/#percorsi`}>Confronta durata e ritmo →</a><br /><a href={`${base}itinerario-giappone-10-giorni/`}>Itinerario dettagliato →</a>
        </article>

        <article class="card">
          <h3>14 giorni</h3>
          <p>
            Tokyo, una pausa a Hakone oppure Kawaguchiko, Kyoto, Nara, Hiroshima e Miyajima; Osaka prima del rientro.
          </p><a href={`${base}primo-viaggio-giappone/#percorsi`}>Confronta durata e ritmo →</a><br /><a href={`${base}itinerario-giappone-14-giorni/`}>Variante con Kanazawa e Takayama →</a>
        </article>

        <article class="card">
          <h3>21 giorni</h3>
          <p>
            Tappe classiche con alcune estensioni tra borghi, città e natura, scelte sui tuoi interessi.
          </p><a href={`${base}giappone-pratico/#durata`}>Idee dalla guida →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Domande frequenti</p>
        <h2>Le risposte prima di iniziare.</h2>
      </div>

      <div class="faq-grid">
        {faq.map(item => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta executive-cta">
      <div>
        <p class="kicker">Il tuo viaggio inizia qui</p>
        <h2>Raccontami il Giappone che immagini.</h2>
        <p>
          Ti aiuterò a trasformare la tua idea in un itinerario organizzato
          sulle tue esigenze.
        </p>
      </div>

      <a class="button button-primary" href={`${base}preventivo/?destinazione=Giappone`}>
        Richiedi il preventivo gratuito
      </a>
    </div>
  </section>
</BaseLayout>
