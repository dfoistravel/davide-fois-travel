---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThailandPhoto from '../components/ThailandPhoto.astro';
const base = import.meta.env.BASE_URL;
const quote = `${base}preventivo/?destinazione=Thailandia`;
const itineraries = [
 {title:'Bangkok e mare', days:'10 giorni · 9 notti', text:'Tre notti a Bangkok per templi, quartieri e mercati, poi sei notti al mare. Scegliamo la costa e l’isola in base al mese di partenza e ai collegamenti.', type:'Mare e relax'},
 {title:'Bangkok e il nord', days:'12 giorni · 11 notti', text:'Quattro notti a Bangkok, con una giornata ad Ayutthaya, cinque a Chiang Mai e due a Chiang Rai. Cultura, cucina e paesaggi del nord, lasciando spazio ai trasferimenti.', type:'Tour culturale'},
 {title:'Cultura, nord e mare', days:'15 giorni · 14 notti', text:'Tre notti a Bangkok, cinque a Chiang Mai e sei su una sola base al mare. Un percorso da adattare alle tue priorità, con voli interni e giornate senza escursioni programmate.', type:'Altro'}
];
const faq = [
 {question:'Quanti giorni dedicare alla Thailandia?',answer:'Queste proposte partono da 10, 12 o 15 giorni. La durata giusta dipende dalle tappe: per un viaggio breve conviene ridurre gli spostamenti e scegliere poche basi.'},
 {question:'Meglio Phuket, Krabi o Koh Samui?',answer:'La scelta dipende da periodo, collegamenti e stile del soggiorno. Le coste del mare delle Andamane e del Golfo hanno stagioni differenti: valuteremo la zona più adatta alle tue date.'},
 {question:'Quanto costa un viaggio in Thailandia?',answer:'Voli, periodo, hotel, escursioni e trasferimenti incidono sul budget. Raccontami le tue preferenze per ricevere un preventivo personalizzato senza impegno.'}
];
const schema = {'@context':'https://schema.org','@type':'TouristDestination',name:'Thailandia',description:'Idee di viaggio personalizzato tra Bangkok, il nord della Thailandia e il mare.'};
---
<BaseLayout title="Viaggio in Thailandia | Itinerari su misura con Davide Fois" description="Bangkok, Chiang Mai e le isole: scopri tre idee di itinerario in Thailandia e richiedi una proposta personalizzata per periodo, durata e budget." image={`${base}images/thailandia/samui-1280.webp`} schema={schema}>
<section class="hero"><div class="container thailand-hero-grid">
 <div><p class="kicker"><a href={`${base}destinazioni/asia/`}>Asia</a> · Thailandia</p><h1>La tua Thailandia, tra templi, natura e mare.</h1><p class="lead">La vita di Bangkok, le tradizioni del nord e il tempo lento delle isole. Costruiamo il tuo viaggio scegliendo tappe, ritmo e soggiorni in base a ciò che ami.</p><div class="actions"><a class="button button-primary" href={quote}>Richiedi un preventivo gratuito</a><a class="button button-ghost" href="#itinerari">Scopri gli itinerari</a></div></div>
 <div><ThailandPhoto photo="samui" hero /><p class="hero-caption">Koh Samui · una pausa sul mare</p></div>
</div></section>
<section class="section"><div class="container"><nav class="experience-links" aria-label="Esplora la Thailandia"><a href="#esperienze">Esperienze →</a><a href="#itinerari">Idee di itinerario →</a><a href="#informazioni">Quando partire e consigli →</a></nav></div></section>
<section class="section"><div class="container"><div class="seo-note"><p class="kicker">Guide per organizzare il viaggio</p><h2>Bangkok: scegli visite, durata e quartiere.</h2><p>Una guida pratica ai templi, alle zone dove soggiornare e alle escursioni, con un’idea di programma per tre giorni pieni.</p><a class="button button-dark" href={`${base}cosa-vedere-bangkok/`}>Leggi la guida Bangkok</a></div></div></section>
<section class="section alt" id="esperienze"><div class="container"><div class="section-head"><p class="kicker">Scegli cosa vivere</p><h2>Tre modi per scoprire la Thailandia.</h2><p>Possiamo combinarli oppure dedicare il viaggio alle esperienze che ti interessano di più.</p></div><div class="grid-3">
 <article class="card"><ThailandPhoto photo="bangkok" /><h3>Città, templi e sapori</h3><p>Bangkok tra architetture, quartieri e cucina locale. Ayutthaya aggiunge una giornata tra templi e rovine della capitale storica.</p><a class="text-link" href={`${base}cosa-vedere-bangkok/`}>Cosa vedere a Bangkok →</a></article>
 <article class="card"><ThailandPhoto photo="chiang-mai" /><h3>Il nord e le sue tradizioni</h3><p>Chiang Mai come base per conoscere la città, i mercati e la cucina del nord. Escursioni nella natura da scegliere secondo stagione, difficoltà e tempo disponibile.</p></article>
 <article class="card"><ThailandPhoto photo="samui" /><h3>Isole, mare e relax</h3><p>Phuket e Krabi sul mare delle Andamane, Koh Samui nel Golfo: scegliamo una base adatta alle tue date, con il giusto equilibrio tra escursioni e riposo.</p></article>
</div></div></section>
<section class="section" id="itinerari"><div class="container"><div class="section-head"><p class="kicker">Idee da cui partire</p><h2>Un itinerario per il tempo che hai.</h2><p>Schemi indicativi, da personalizzare. Le durate si riferiscono al soggiorno in Thailandia; voli internazionali e orari possono richiedere giorni aggiuntivi.</p></div><div class="grid-3">{itineraries.map(item => <article class="card itinerary-card"><p class="kicker">{item.days}</p><h3>{item.title}</h3><p>{item.text}</p><a class="text-link" href={`${quote}&tipo=${encodeURIComponent(item.type)}`}>Personalizza questo viaggio →</a></article>)}</div></div></section>
<section class="section alt" id="informazioni"><div class="container"><div class="section-head"><p class="kicker">Prima di scegliere</p><h2>Periodo, spostamenti e ritmo del viaggio.</h2></div><div class="grid-3">
 <article class="card"><h3>Quando partire</h3><p>Per il nord, novembre–febbraio è in genere il periodo più fresco; da marzo il caldo aumenta. Per Phuket e Krabi, novembre–aprile è generalmente più favorevole. Koh Samui segue un andamento diverso, con maggio–settembre come possibile alternativa da valutare.</p><p>Il clima varia da un anno all’altro: scegliamo la zona sul periodo di viaggio e controlliamo le condizioni prima della partenza.</p></article>
 <article class="card"><h3>Come spostarsi</h3><p>Per collegare Bangkok, il nord e il mare possiamo valutare voli interni. Treni e trasferimenti via terra sono alternative da confrontare con le distanze e il tempo a disposizione.</p><p>Per le isole consideriamo anche traghetti, orari e condizioni del mare, evitando coincidenze troppo strette.</p></article>
 <article class="card"><h3>Preparare la partenza</h3><p>Definiamo aeroporto di partenza, budget, categoria degli hotel e attività desiderate. Nei templi prevedi abiti che coprano spalle e ginocchia.</p><p>Per documenti, requisiti d’ingresso e aggiornamenti consulta la <a href="https://www.viaggiaresicuri.it/find-country/country/THA" target="_blank" rel="noopener noreferrer">scheda Thailandia di Viaggiare Sicuri</a> prima di prenotare e partire.</p></article>
</div><p class="sources-note">Indicazioni stagionali: <a href="https://thai.tourismthailand.org/Articles/วางแผนเที่ยว-คำถามที่พบบ่อย" target="_blank" rel="noopener noreferrer">Tourism Authority of Thailand</a>. Sono orientamenti climatici, non previsioni.</p></div></section>
<section class="section"><div class="container"><div class="section-head"><p class="kicker">Domande frequenti</p><h2>Partiamo dalle tue domande.</h2></div><div class="faq-grid">{faq.map(item => <details class="faq-item"><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>
<section class="section alt"><div class="container cta executive-cta"><div><p class="kicker">Il tuo viaggio inizia qui</p><h2>Quale Thailandia immagini?</h2><p>Raccontami quando vorresti partire, con chi viaggi e cosa ti piacerebbe vivere. Ti aiuterò a scegliere tappe e soggiorni per una proposta su misura.</p></div><a class="button button-primary" href={quote}>Richiedi il preventivo gratuito</a></div></section>
<div class="container thailand-credits"><p>Foto da Wikimedia Commons: <a href="https://commons.wikimedia.org/wiki/File:Thailand_Koh_Samui_Island_Beach.jpg">Koh Samui / fallix</a> e <a href="https://commons.wikimedia.org/wiki/File:Temple_Spires_(22934502922).jpg">Bangkok / Mustang Joe</a>, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>; <a href="https://commons.wikimedia.org/wiki/File:Chiang_mai.jpg">Chiang Mai / Martin-Manuel Beaulne</a>, pubblico dominio. Immagini ridimensionate e ritagliate per il sito.</p></div>
</BaseLayout>
<style>
.thailand-hero-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:48px;align-items:center;padding:70px 0}.hero-caption{color:#e5eaf0;font-size:.85rem;margin:12px 0 0}.hero .kicker a{color:inherit}.itinerary-card{display:flex;flex-direction:column}.itinerary-card .text-link{margin-top:auto;padding-top:18px}.sources-note,.thailand-credits{font-size:.85rem;line-height:1.6;color:var(--muted)}.sources-note{margin-top:28px}.thailand-credits{padding-top:18px;padding-bottom:30px;overflow-wrap:anywhere}
@media(max-width:900px){.thailand-hero-grid{grid-template-columns:1fr;gap:30px;padding:48px 0}}
</style>
