---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tohokuPlaces } from '../../data/tohokuPlaces';
const base=import.meta.env.BASE_URL;
const photoUrl=(filename:string)=>`https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(filename)}?width=1280`;
---
<BaseLayout title="Tohoku: guida del Giappone settentrionale | D. Fois Travel" description="Scopri Tohoku: Sendai, Matsushima, Hirosaki, Oirase, Hiraizumi, Ginzan Onsen e luoghi meno conosciuti. Otto guide e itinerari su misura.">
  <section class="hero"><div class="container th-hero"><p class="kicker"><a href={`${base}giappone/regioni/`}>Regioni del Giappone</a> · Tohoku</p><h1>Tohoku: il Giappone più autentico, tra templi e natura.</h1><p class="lead">Sei prefetture, tradizioni vive, paesaggi straordinari e sorgenti termali. Parti da una zona, scopri le esperienze e scegli un ritmo di viaggio sostenibile.</p><div class="actions"><a class="button button-primary" href="#destinazioni">Esplora le otto guide</a><a class="button button-ghost" href="#itinerari">Idee di itinerario</a></div></div></section>
  <section class="section" id="destinazioni"><div class="container"><div class="section-head"><p class="kicker">Sei prefetture · otto approfondimenti</p><h2>Le destinazioni del Tohoku</h2><p>Ogni area è diversa: non occorre visitarle tutte in un unico viaggio. Le guide aiutano a scegliere.</p></div><div class="th-grid">{tohokuPlaces.map(place => <article class="card th-card">{place.photo && <img src={photoUrl(place.photo)} alt={place.name} loading="lazy" decoding="async" />}<div class="th-cardbody"><p class="kicker">{place.area} · {place.days}</p><h3>{place.name}</h3><p>{place.summary}</p><a class="button button-dark" href={`${base}tohoku/${place.slug}/`}>Scopri la guida →</a></div></article>)}</div></div></section>
  <section class="section alt" id="itinerari"><div class="container"><div class="section-head"><p class="kicker">Come organizzare il viaggio</p><h2>Tre idee, senza correre</h2></div><div class="grid-3"><article class="card"><h3>5–6 giorni · Tohoku culturale</h3><p>Sendai, Matsushima e Hiraizumi, con pernottamenti ben distribuiti.</p></article><article class="card"><h3>8–10 giorni · Cultura e terme</h3><p>Sendai, Yamadera, Ginzan Onsen e Akita/Kakunodate. Verifica gli spostamenti locali.</p></article><article class="card"><h3>10–14 giorni · Nord naturalistico</h3><p>Hirosaki, Oirase, Towada e Akita, scegliendo la stagione e una combinazione di trasporti realistica.</p></article></div></div></section>
  <section class="section"><div class="container"><div class="grid-3"><article class="card"><h3>Primavera</h3><p>Fioriture di Hirosaki e Kakunodate, con date variabili ogni anno.</p></article><article class="card"><h3>Estate e autunno</h3><p>Festival estivi, boschi, cascate, foliage e cammini in quota secondo le condizioni.</p></article><article class="card"><h3>Inverno</h3><p>Terme, villaggi innevati e le particolari formazioni di neve dei monti Zao.</p></article></div><div class="cta"><div><p class="kicker">Il tuo Tohoku su misura</p><h2>Quale Giappone vuoi scoprire?</h2><p>Raccontami periodo, giorni e interessi: costruiamo il tuo itinerario.</p></div><a class="button button-primary" href={`${base}preventivo/?destinazione=Tohoku`}>Richiedi una proposta</a></div><p class="th-source">Approfondimenti: <a href="https://www.japan.travel/it/destinations/tohoku/" target="_blank" rel="noopener noreferrer">Ente Nazionale del Turismo Giapponese</a>. Orari e accessi possono variare secondo la stagione.</p></div></section>
</BaseLayout>
<style>.th-hero{padding:62px 0 64px;max-width:1000px}.th-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.th-card{padding:0;overflow:hidden;display:flex;flex-direction:column}.th-card img{width:100%;aspect-ratio:16/9;object-fit:cover}.th-cardbody{padding:24px;display:flex;flex-direction:column;gap:10px;flex:1}.th-cardbody p{flex:1}.th-cardbody .button{align-self:start}.th-source{font-size:.88rem;color:var(--muted);margin-top:22px}@media(max-width:700px){.th-grid{grid-template-columns:1fr}.th-hero{padding:40px 0}}</style>
