---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tohokuPlaces } from '../../data/tohokuPlaces';
export function getStaticPaths(){return tohokuPlaces.map(place => ({params:{slug:place.slug}, props:{place}}));}
const { place } = Astro.props;
const base=import.meta.env.BASE_URL;
const photoUrl=(filename:string)=>`https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(filename)}?width=1280`;
---
<BaseLayout title={`${place.name}: cosa vedere nel Tohoku | D. Fois Travel`} description={`${place.summary} Luoghi da visitare, consigli e periodo migliore.`}>
  <section class="hero"><div class="container th-detail">{place.photo && <figure><img src={photoUrl(place.photo)} alt={place.name} loading="eager" decoding="async"/><figcaption>Fotografia: {place.credit} · <a href={`https://commons.wikimedia.org/wiki/File:${encodeURIComponent(place.photo)}`} target="_blank" rel="noopener noreferrer">immagine e condizioni di riutilizzo su Wikimedia Commons</a></figcaption></figure>}<div><p class="kicker"><a href={`${base}tohoku/`}>Tohoku</a> · {place.area}</p><h1>{place.name}</h1><p class="lead">{place.summary}</p><div class="actions"><a class="button button-primary" href="#luoghi">Cosa vedere</a><a class="button button-ghost" href={`${base}tohoku/`}>Tutte le guide</a></div></div></div></section>
  <section class="section" id="luoghi"><div class="container"><div class="section-head"><p class="kicker">Cultura e natura</p><h2>Tre esperienze da considerare</h2><p>Verifica collegamenti e orari: alcune tappe non sono combinabili in giornata.</p></div><div class="grid-3">{place.spots.map(spot => <article class="card"><h3>{spot[0]}</h3><p>{spot[1]}</p></article>)}</div></div></section>
  <section class="section alt"><div class="container th-tips"><article class="card"><h3>Quanto tempo dedicare</h3><p>{place.days}</p><h3>Quando andare</h3><p>{place.season}</p></article><article class="card"><h3>Come organizzare</h3><p>{place.tip}</p><p>Controlla servizi e orari aggiornati, soprattutto per trasporti stagionali e percorsi montani.</p></article></div></section>
  <section class="section"><div class="container"><div class="cta"><div><p class="kicker">Viaggio su misura</p><h2>Vuoi includere {place.name} nel tuo viaggio?</h2><p>Confrontiamo date, giorni e budget per costruire un itinerario equilibrato.</p></div><a class="button button-primary" href={`${base}preventivo/?destinazione=Tohoku`}>Richiedi una proposta</a></div><p class="th-source">Fonte di riferimento: <a href={place.source} target="_blank" rel="noopener noreferrer">turismo ufficiale / JNTO</a>. Le esperienze stagionali possono variare.</p><a href={`${base}tohoku/`}>← Torna alle guide Tohoku</a></div></section>
</BaseLayout>
<style>.th-detail{padding:62px 0;display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center}.th-detail:has(>div:only-child){grid-template-columns:1fr}.th-detail figure{margin:0}.th-detail img{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:22px}.th-detail figcaption{font-size:.75rem;color:#e1e6eb;margin-top:8px}.th-tips{display:grid;grid-template-columns:1fr 1fr;gap:22px}.th-source{font-size:.86rem;color:var(--muted);margin-top:20px}@media(max-width:800px){.th-detail,.th-tips{grid-template-columns:1fr}}@media(max-width:700px){.th-detail{padding:42px 0}}</style>
