---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tohokuPlaces } from '../../data/tohokuPlaces';
export function getStaticPaths(){return tohokuPlaces.map(place => ({params:{slug:place.slug}, props:{place}}));}
const { place } = Astro.props;
const base=import.meta.env.BASE_URL;
---
<BaseLayout title={`${place.name}: cosa vedere nel Tohoku | D. Fois Travel`} description={`${place.summary} Luoghi da visitare, consigli e periodo migliore.`}>
  <section class="hero"><div class="container th-detail"><p class="kicker"><a href={`${base}tohoku/`}>Tohoku</a> · {place.area}</p><h1>{place.name}</h1><p class="lead">{place.summary}</p><div class="actions"><a class="button button-primary" href="#luoghi">Cosa vedere</a><a class="button button-ghost" href={`${base}tohoku/`}>Tutte le guide</a></div></div></section>
  <section class="section" id="luoghi"><div class="container"><div class="section-head"><p class="kicker">Cultura e natura</p><h2>Tre esperienze da considerare</h2><p>Verifica collegamenti e orari: alcune tappe non sono combinabili in giornata.</p></div><div class="grid-3">{place.spots.map(spot => <article class="card"><h3>{spot[0]}</h3><p>{spot[1]}</p></article>)}</div></div></section>
  <section class="section alt"><div class="container th-tips"><article class="card"><h3>Quanto tempo dedicare</h3><p>{place.days}</p><h3>Quando andare</h3><p>{place.season}</p></article><article class="card"><h3>Come organizzare</h3><p>{place.tip}</p><p>Controlla servizi e orari aggiornati, soprattutto per trasporti stagionali e percorsi montani.</p></article></div></section>
  <section class="section"><div class="container"><div class="cta"><div><p class="kicker">Viaggio su misura</p><h2>Vuoi includere {place.name} nel tuo viaggio?</h2><p>Confrontiamo date, giorni e budget per costruire un itinerario equilibrato.</p></div><a class="button button-primary" href={`${base}preventivo/?destinazione=Tohoku`}>Richiedi una proposta</a></div><p class="th-source">Fonte di riferimento: <a href="https://www.japan.travel/it/destinations/tohoku/" target="_blank" rel="noopener noreferrer">JNTO – Tohoku</a>.</p><a href={`${base}tohoku/`}>← Torna alle guide Tohoku</a></div></section>
</BaseLayout>
<style>.th-detail{padding:62px 0;max-width:1000px}.th-tips{display:grid;grid-template-columns:1fr 1fr;gap:22px}.th-source{font-size:.86rem;color:var(--muted);margin-top:20px}@media(max-width:700px){.th-tips{grid-template-columns:1fr}.th-detail{padding:42px 0}}</style>
